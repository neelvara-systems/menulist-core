      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskContentCalendarItems/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskContentPerformanceSummaries/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskProofPermissions/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskTrustPartnerProfiles/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskTrustPartnerNicheTests/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskTrustPartnerDeals/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskTrustPartnerBriefs/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskTrustPartnerDeliverables/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskTrustPartnerMetrics/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskTrustPartnerRenewalDecisions/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskRevenueAccounts/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskCommercialOpportunities/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskCommercialOffers/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskOperatingEnvelopes/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskActivationWatches/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    match /signaldeskRevenueControlSummaries/{docId} {
      allow read: if canReadSignalDesk();
      allow write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignalDeskPlatformAdmin() {
      return isAuthenticated()
        && request.auth.token.platformRole == 'PLATFORM';
    }

    function isSignedInSignalDeskMember() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/signaldeskTeamMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/signaldeskTeamMembers/$(request.auth.uid)).data.pId == 'SD'
        && get(/databases/$(database)/documents/signaldeskTeamMembers/$(request.auth.uid)).data.teamMemberId == request.auth.uid
        && get(/databases/$(database)/documents/signaldeskTeamMembers/$(request.auth.uid)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/signaldeskTeamMembers/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/signaldeskTeamMembers/$(request.auth.uid)).data.status == 'active'
        && isSignalDeskHumanRole(
          get(/databases/$(database)/documents/signaldeskTeamMembers/$(request.auth.uid)).data.role
        );
    }

    function isSignalDeskHumanRole(role) {
      return role == 'founder-admin'
        || role == 'growth-manager'
        || role == 'operator'
        || role == 'compliance-reviewer'
        || role == 'readonly-analyst';
    }

    function isSignalDeskResource() {
      return resource.data.pId == 'SD';
    }

    function canReadSignalDesk() {
      return isSignalDeskPlatformAdmin() && isSignalDeskResource();
    }
  }
}
