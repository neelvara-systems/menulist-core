{
  "name": "signaldesk-functions",
  "description": "MenuList SignalDesk Cloud Functions",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions --config ../firebase-signaldesk.json",
    "shell": "npm run build && firebase functions:shell --config ../firebase-signaldesk.json",
    "deploy": "npm run deploy:prod",
    "deploy:qa": "firebase deploy --only functions:signaldesk --project menulist-signaldesk-qa --config ../firebase-signaldesk.json",
    "deploy:prod": "firebase deploy --only functions:signaldesk --project menulist-signaldesk --config ../firebase-signaldesk.json",
    "logs": "npm run logs:prod",
    "logs:qa": "firebase functions:log --project menulist-signaldesk-qa --config ../firebase-signaldesk.json",
    "logs:prod": "firebase functions:log --project menulist-signaldesk --config ../firebase-signaldesk.json"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
