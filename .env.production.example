# Final env template - Production
# Copy this to Vercel Production.
# Do not commit real values.
#
# Env variable names use full product names only:
# MENULIST_*, ANSWERLATTICE_*, CAMPAIGNCUE_*, SIGNALDESK_*, NEELVARA_*, MYCODEX_*.
# ML, AL, CC, MC, and SD are internal product codes, not env prefixes.
# Neelvara is a static parent site target and does not reserve an env prefix beyond NEELVARA_*.

# Runtime identity and routing
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_VERCEL_ENV=production
NEXT_PUBLIC_APP_URL=https://menulist.ai
NEXT_PUBLIC_DEPLOYMENT_URL=https://menulist.ai
NEXT_PUBLIC_PLATFORM_DOMAIN=menulist.ai
NEXT_PUBLIC_PLATFORM_DOMAIN_ALIASES=menulist.ai,www.menulist.ai,app.menulist.ai
NEXT_PUBLIC_MENULIST_TENANT_BASE_DOMAIN=menulist.online
NEXT_PUBLIC_BUILD_ID=
NEXT_PUBLIC_BUILD_CREATED_AT=
NEXT_PUBLIC_ENABLE_DEPLOYMENT_BUILD_BADGE=false

# Auth
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# Canonical production owner-app/auth origin.
NEXTAUTH_URL=https://app.menulist.ai

# Owner referral token encryption. Required before ENABLE_OWNER_REFERRAL is enabled.
# Generate an unpadded 32-byte base64url value, for example with Node crypto.
MENULIST_OWNER_REFERRAL_TOKEN_SECRET=<generate-32-byte-base64url-secret>

# MenuList Firebase - canonical production values use menulist
NEXT_PUBLIC_MENULIST_FIREBASE_API_KEY=<menulist-web-api-key>
NEXT_PUBLIC_MENULIST_FIREBASE_AUTH_DOMAIN=<menulist-auth-domain>
NEXT_PUBLIC_MENULIST_FB_DATABASE_URL=<menulist-realtime-database-url>
NEXT_PUBLIC_MENULIST_FIREBASE_PROJECT_ID=menulist
NEXT_PUBLIC_MENULIST_FIREBASE_STORAGE_BUCKET=<menulist-storage-bucket>
NEXT_PUBLIC_MENULIST_FIREBASE_MESSAGING_SENDER_ID=<menulist-messaging-sender-id>
NEXT_PUBLIC_MENULIST_FIREBASE_APP_ID=<menulist-web-app-id>
NEXT_PUBLIC_MENULIST_FIREBASE_MEASUREMENT_ID=<menulist-ga-measurement-id>
MENULIST_FIREBASE_CLIENT_EMAIL=<menulist-service-account-client-email>
MENULIST_FIREBASE_PRIVATE_KEY=<menulist-service-account-private-key-with-escaped-newlines>
MENULIST_FIREBASE_PROJECT_LOCATION=us-central1

# Answerlattice Firebase - production uses answerlattice
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_MODE=separate
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_API_KEY=<answerlattice-web-api-key>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_AUTH_DOMAIN=<answerlattice-auth-domain>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_PROJECT_ID=answerlattice
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_STORAGE_BUCKET=<answerlattice-storage-bucket>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_MESSAGING_SENDER_ID=<answerlattice-messaging-sender-id>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_APP_ID=<answerlattice-web-app-id>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_MEASUREMENT_ID=<answerlattice-ga-measurement-id>
NEXT_PUBLIC_ANSWERLATTICE_FIRESTORE_DATABASE_ID=
ANSWERLATTICE_FIREBASE_CLIENT_EMAIL=<answerlattice-service-account-client-email>
ANSWERLATTICE_FIREBASE_PRIVATE_KEY=<answerlattice-service-account-private-key-with-escaped-newlines>
ANSWERLATTICE_GOOGLE_APPLICATION_CREDENTIALS=
ANSWERLATTICE_CRON_SECRET=<shared-with-answerlattice-functions-secret>
ANSWERLATTICE_GEMINI_AI_KEY=<answerlattice-gemini-api-key>
ANSWERLATTICE_GEMINI_AI_KEY_2=
ANSWERLATTICE_GEMINI_AI_KEY_3=
ANSWERLATTICE_GEMINI_AI_KEY_4=
# Local admission ceiling; keep below the active AI Studio project limit.
ANSWERLATTICE_GEMINI_SPEND_LIMIT_USD_10M=8
ANSWERLATTICE_UPSTASH_REDIS_REST_URL=
ANSWERLATTICE_UPSTASH_REDIS_REST_TOKEN=
ANSWERLATTICE_MCP_SESSION_SECRET=<generate-with-openssl-rand-base64-32>
ANSWERLATTICE_GITHUB_APP_ID=<github-app-id>
ANSWERLATTICE_GITHUB_APP_SLUG=<github-app-slug>
ANSWERLATTICE_GITHUB_APP_PRIVATE_KEY=<github-app-private-key-with-escaped-newlines>
ANSWERLATTICE_GITHUB_APP_CLIENT_ID=<github-app-client-id>
ANSWERLATTICE_GITHUB_APP_CLIENT_SECRET=<github-app-client-secret>
ANSWERLATTICE_GITHUB_WEBHOOK_SECRET=<generate-with-openssl-rand-base64-32>
ANSWERLATTICE_GITHUB_STATE_SECRET=<generate-with-openssl-rand-base64-32>
ANSWERLATTICE_WIDGET_RUNTIME_SECRET=<generate-with-openssl-rand-base64-32>
ANSWERLATTICE_PUBLIC_BUNDLE_SALT=<generate-random-salt>
ANSWERLATTICE_NIGHTLY_TRIGGER_URL=<answerlattice-manual-scheduler-url>
ANSWERLATTICE_TRIGGER_NIGHTLY_URL=<answerlattice-manual-scheduler-url>
ANSWERLATTICE_PUBLIC_API_DEBUG=false
ANSWERLATTICE_TEST_URL=https://answerlattice.com
NEXT_PUBLIC_ANSWERLATTICE_WIDGET_KEY=<answerlattice-public-widget-key>

# CampaignCue Firebase - production uses campaigncue
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_MODE=separate
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_API_KEY=<campaigncue-web-api-key>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_AUTH_DOMAIN=<campaigncue-auth-domain>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_PROJECT_ID=campaigncue
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_STORAGE_BUCKET=<campaigncue-storage-bucket>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_MESSAGING_SENDER_ID=<campaigncue-messaging-sender-id>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_APP_ID=<campaigncue-web-app-id>
NEXT_PUBLIC_CAMPAIGNCUE_FIRESTORE_DATABASE_ID=
CAMPAIGNCUE_FIREBASE_CLIENT_EMAIL=<campaigncue-service-account-client-email>
CAMPAIGNCUE_FIREBASE_PRIVATE_KEY=<campaigncue-service-account-private-key-with-escaped-newlines>
CAMPAIGNCUE_GOOGLE_APPLICATION_CREDENTIALS=

# CampaignCue CueLayers model registry
# Premium accepts an explicit true/false gate. Leave the segmentation model ID
# blank to disable it. Rollouts are clamped to 0-100 and 0 selects no traffic.
CAMPAIGNCUE_CUE_LAYERS_LOW_COST_IMAGE_MODEL=
CAMPAIGNCUE_CUE_LAYERS_ENABLE_PREMIUM_MODEL=false
CAMPAIGNCUE_CUE_LAYERS_PREMIUM_IMAGE_MODEL=
CAMPAIGNCUE_CUE_LAYERS_PREMIUM_ROLLOUT_PERCENT=0
CAMPAIGNCUE_CUE_LAYERS_SEGMENTATION_MODEL=
CAMPAIGNCUE_CUE_LAYERS_SEGMENTATION_ROLLOUT_PERCENT=0
CAMPAIGNCUE_TEMPLATE_SEED_ACTOR=campaigncue-template-seed

# SignalDesk - production uses its separate menulist-signaldesk project
NEXT_PUBLIC_SIGNALDESK_FIREBASE_MODE=separate
NEXT_PUBLIC_SIGNALDESK_FIREBASE_API_KEY=<menulist-signaldesk-web-api-key>
NEXT_PUBLIC_SIGNALDESK_FIREBASE_AUTH_DOMAIN=<menulist-signaldesk-auth-domain>
NEXT_PUBLIC_SIGNALDESK_FIREBASE_PROJECT_ID=menulist-signaldesk
NEXT_PUBLIC_SIGNALDESK_FIREBASE_STORAGE_BUCKET=menulist-signaldesk.firebasestorage.app
NEXT_PUBLIC_SIGNALDESK_FIREBASE_MESSAGING_SENDER_ID=<menulist-signaldesk-messaging-sender-id>
NEXT_PUBLIC_SIGNALDESK_FIREBASE_APP_ID=<menulist-signaldesk-web-app-id>
NEXT_PUBLIC_SIGNALDESK_FIRESTORE_DATABASE_ID=
SIGNALDESK_FIREBASE_MODE=separate
SIGNALDESK_FIREBASE_PROJECT_ID=menulist-signaldesk
SIGNALDESK_FIREBASE_STORAGE_BUCKET=menulist-signaldesk.firebasestorage.app
SIGNALDESK_FIREBASE_CLIENT_EMAIL=<menulist-signaldesk-service-account-client-email>
SIGNALDESK_FIREBASE_PRIVATE_KEY=<menulist-signaldesk-service-account-private-key-with-escaped-newlines>
SIGNALDESK_GOOGLE_APPLICATION_CREDENTIALS=
SIGNALDESK_FIRESTORE_DATABASE_ID=
SIGNALDESK_GEMINI_AI_KEY=<menulist-signaldesk-gemini-api-key>
SIGNALDESK_GEMINI_AI_KEY_2=
SIGNALDESK_GEMINI_AI_KEY_3=
SIGNALDESK_GEMINI_AI_KEY_4=
SIGNALDESK_GEMINI_SPEND_LIMIT_USD_10M=8
SIGNALDESK_AI_MODEL=
SIGNALDESK_OUTCOME_BRIDGE_SECRET=<signaldesk-outcome-bridge-hmac-secret>
# Optional SignalDesk source/send providers. Leave blank until the matching provider
# account, legal approval, budget cap, and provider-send gate are explicitly approved.
SIGNALDESK_APIFY_API_TOKEN=
SIGNALDESK_APIFY_SOURCE_ACTOR_ID=
SIGNALDESK_APIFY_WEBHOOK_SECRET=
SIGNALDESK_GOOGLE_PLACES_API_KEY=
SIGNALDESK_META_ACCESS_TOKEN=
SIGNALDESK_META_APP_SECRET=
SIGNALDESK_META_VERIFY_TOKEN=
SIGNALDESK_MESSENGER_PAGE_ID=
SIGNALDESK_INSTAGRAM_PAGE_ID=
SIGNALDESK_WHATSAPP_PHONE_NUMBER_ID=
SIGNALDESK_EMAIL_FROM=
SIGNALDESK_EMAIL_REPLY_TO=
SIGNALDESK_EMAIL_WEBHOOK_SECRET=
SIGNALDESK_SMTP_HOST=
SIGNALDESK_SMTP_PORT=
SIGNALDESK_SMTP_SECURE=false
SIGNALDESK_SMTP_USER=
SIGNALDESK_SMTP_PASS=
SIGNALDESK_UNSUBSCRIBE_URL=
SIGNALDESK_PHYSICAL_ADDRESS=
SIGNALDESK_SMARTLEAD_API_KEY=
SIGNALDESK_SMARTLEAD_WEBHOOK_SECRET=

# Static products
# MyCodex is static/no DB. Do not add Firebase, billing, Storage, or Functions env keys.
# Neelvara is static/no DB. These public values only control displayed mailto links and structured data.
NEXT_PUBLIC_NEELVARA_CONTACT_EMAIL=hello@neelvara.com
NEXT_PUBLIC_NEELVARA_LEGAL_EMAIL=legal@neelvara.com
NEXT_PUBLIC_NEELVARA_PRIVACY_EMAIL=privacy@neelvara.com
MYCODEX_BASIC_AUTH_USER=<internal-docs-username>
MYCODEX_BASIC_AUTH_PASSWORD=<internal-docs-password>
MYCODEX_SESSION_SECRET=<generate-with-openssl-rand-base64-32>

# Shared MenuList AI pool: primary plus rotation slots 2 and 3 only.
MENULIST_GEMINI_AI_KEY=<google-ai-studio-or-vertex-compatible-gemini-key>
MENULIST_GEMINI_AI_KEY_2=
MENULIST_GEMINI_AI_KEY_3=
MENULIST_GEMINI_SPEND_LIMIT_USD_10M=8
# Menu extraction uses MENULIST_GEMINI_TEXT_AI_KEY in Firebase Secret Manager only.
# Other Firebase Functions use project-local GEMINI_AI_KEY, _2, and _3 names.
OPENAI_API_KEY=

# Payments and billing
MENULIST_RAZORPAY_KEY_SECRET=<razorpay-live-secret>
MENULIST_RAZORPAY_WEBHOOK_SECRET=<razorpay-live-webhook-secret>
NEXT_PUBLIC_MENULIST_RAZORPAY_KEY_ID=rzp_live_<id>
CRON_SECRET=<internal-cron-secret>
INTERNAL_BILLING_EMAIL=<billing-email>
# Create alert-only and Gemini API spend-cap budgets before paid Firebase/Gemini
# production usage. This secret only protects the optional alert webhook.
GCP_BUDGET_WEBHOOK_SECRET=<gcp-budget-webhook-secret>

# Rate limiting, cache, and public revalidation
MENULIST_UPSTASH_REDIS_REST_URL=<production-upstash-rest-url>
MENULIST_UPSTASH_REDIS_REST_TOKEN=<production-upstash-rest-token>
MENULIST_REVALIDATION_SECRET=<same-value-in-vercel-and-firebase-secret-manager>

# Public form bot protection.
# If TURNSTILE_SECRET_KEY is set, NEXT_PUBLIC_TURNSTILE_SITE_KEY must also be set so public forms can send captchaToken.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Cloud Tasks batch image generation
# Uses NEXT_PUBLIC_MENULIST_FIREBASE_PROJECT_ID and MENULIST_FIREBASE_PROJECT_LOCATION above.
MENULIST_BATCH_IMAGE_GENERATION_WORKER_URL=https://app.menulist.ai/api/image-generation/batch-generation
MENULIST_BATCH_IMAGE_GENERATION_QUEUE_ID=batch-image-generation
MENULIST_BATCH_IMAGE_GENERATION_WORKER_SECRET=<production-worker-secret>

# Analytics and public media integrations
GA_CLIENT_EMAIL=<ga4-service-account-email>
GA_PRIVATE_KEY=<ga4-private-key-with-escaped-newlines>
GA_PROJECT_ID=<ga4-gcp-project-id>
NEXT_PUBLIC_GA_MEASUREMENT_ID=<production-ga-measurement-id>
NEXT_PUBLIC_CLARITY_ID=<production-clarity-id>
NEXT_PUBLIC_MENULIST_PLAUSIBLE_DOMAIN=menulist.ai
NEXT_PUBLIC_MENULIST_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_ANSWERLATTICE_PLAUSIBLE_DOMAIN=answerlattice.com
NEXT_PUBLIC_ANSWERLATTICE_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_UNSPLASH_API_CLIENTID=
NEXT_PUBLIC_PIXABAY_API_CLIENTID=
NEXT_PUBLIC_PEXELS_API_CLIENTID=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Sentry and release metadata for the shared Vercel app. Server/edge reuse the
# public DSN; Firebase Functions use project-local SENTRY_DSN Secret Manager.
NEXT_PUBLIC_SENTRY_DSN=<production-sentry-dsn>
SENTRY_AUTH_TOKEN=<sentry-source-map-upload-token>
SENTRY_ORG=<sentry-org-slug>
SENTRY_PROJECT=<sentry-project-slug>
SENTRY_RELEASE=
SENTRY_ENABLED_IN_EMULATOR=false

# Firebase App Check and emulator controls
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<production-recaptcha-v3-site-key>
NEXT_PUBLIC_MENULIST_FIREBASE_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_USE_EMULATORS=false
FUNCTIONS_EMULATOR=false
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# Email and platform notifications
MENULIST_SMTP_HOST=smtp.gmail.com
MENULIST_SMTP_PORT=587
MENULIST_SMTP_USER=<production-sender-email>
MENULIST_SMTP_PASS=<production-app-password>
MENULIST_TELEGRAM_BOT_TOKEN=<production-telegram-bot-token>
MENULIST_TELEGRAM_CHAT_ID=<production-telegram-chat-id>
INTERNAL_NOTIFICATION_EMAIL=<ops-email>
INTERNAL_NOTIFICATION_WHATSAPP=
PLATFORM_ALERT_EMAIL_TO=<ops-email>
PLATFORM_ALERT_WHATSAPP_TO=
PLATFORM_ALERT_WHATSAPP_TEMPLATE_NAME=
PLATFORM_ALERT_WHATSAPP_TEMPLATE_LANGUAGE=en_US
PLATFORM_ALERT_WHATSAPP_SESSION_ACTIVE=false
SLACK_WEBHOOK_URL=

# Optional Next.js WhatsApp outbound paths. Populate the phone id and access
# token only for an approved phone OTP or owner-notification smoke.
MENULIST_WHATSAPP_PHONE_NUMBER_ID=
MENULIST_WHATSAPP_ACCESS_TOKEN=
MENULIST_WHATSAPP_OTP_TEMPLATE_NAME=
MENULIST_WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
MENULIST_WHATSAPP_OTP_ALLOW_TEXT_FALLBACK=false
PHONE_OTP_DEV_CODE=
PHONE_OTP_DEV_SKIP_SEND=false
PHONE_OTP_DEBUG_RESPONSE=false
# Firebase Functions keep app/verify secrets in project-local Secret Manager and
# onboarding flags in functions/.env.menulist, not in the root app env.
NEXT_PUBLIC_MSG_PREVIEW_BASE_URL=https://app.menulist.ai

# MenuList owner app Answerlattice widget embed
NEXT_PUBLIC_MENULIST_ANSWERLATTICE_WIDGET_KEY=
NEXT_PUBLIC_MENULIST_ANSWERLATTICE_WIDGET_SCRIPT_SRC=https://answerlattice.com/widget/v1/answerlattice-widget.js

# Menu link import browser controls
MENU_LINK_IMPORT_CHROME_PATH=
MENU_LINK_IMPORT_CHROME_NO_SANDBOX=false

# Vercel Domains API - only needed when domain automation is enabled
# Vercel auto-provides VERCEL, VERCEL_ENV, VERCEL_URL, and commit metadata.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional webhook verification secrets
GITHUB_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=
