# Firebase Functions dotenv template for MenuList staging/QA project ecomsai.
# Copy to functions/.env.ecomsai for non-secret runtime env only.
# Store secrets with firebase functions:secrets:set instead.

NEXT_PUBLIC_APP_URL=https://menulist.online
NEXT_PUBLIC_MSG_PREVIEW_BASE_URL=https://menulist.online/msg-preview
ENABLE_MESSAGING_ONBOARDING=false
MESSAGING_ONBOARDING_PROVIDERS=whatsapp

