# Firebase Functions dotenv template for MenuList production project menulist.
# Copy to functions/.env.menulist for non-secret runtime env only.
# Store secrets with firebase functions:secrets:set instead.

NEXT_PUBLIC_APP_URL=https://app.menulist.ai
MENULIST_TENANT_BASE_DOMAIN=menulist.online
NEXT_PUBLIC_MSG_PREVIEW_BASE_URL=https://app.menulist.ai
# Non-secret local ceiling; set only after verifying the active AI Studio tier.
MENULIST_GEMINI_SPEND_LIMIT_USD_10M=8
# Enable only after real Meta secrets and webhook registration exist.
ENABLE_MESSAGING_ONBOARDING=false
MESSAGING_ONBOARDING_PROVIDERS=whatsapp
ENABLE_MESSAGING_ONBOARDING_TRACKING=true
