# Firebase Functions dotenv template for MenuList production project menulist-prod.
# Copy to functions/.env.menulist-prod for non-secret runtime env only.
# Store secrets with firebase functions:secrets:set instead.

NEXT_PUBLIC_APP_URL=https://app.menulist.ai
MENULIST_TENANT_BASE_DOMAIN=menulist.online
NEXT_PUBLIC_MSG_PREVIEW_BASE_URL=https://app.menulist.ai
# Non-secret local ceiling; set only after verifying the active AI Studio tier.
MENULIST_GEMINI_SPEND_LIMIT_USD_10M=8
# Enable only after real Meta secrets and webhook registration exist.
ENABLE_MESSAGING_ONBOARDING=false
MESSAGING_ONBOARDING_PROVIDERS=whatsapp
ENABLE_MESSAGING_ONBOARDING_TRACKING=true
# Keep every production WhatsApp delivery surface parked until the final
# business-owned Meta boundary and truthful legal documents exist.
WHATSAPP_OS_ENABLED=false
OWNER_NOTIFICATION_WHATSAPP_ENABLED=false
PLATFORM_ALERT_WHATSAPP_ENABLED=false

# Meta credentials are secrets and belong in Secret Manager under the canonical
# MENULIST_WHATSAPP_* names. They must never be added to this dotenv file.

# EmailOS non-secret sender policy. Populate only during the separate Resend
# onboarding; API and webhook credentials belong in Secret Manager.
MENULIST_EMAIL_OS_FROM_DOMAIN=
MENULIST_EMAIL_OS_FROM=
MENULIST_EMAIL_OS_REPLY_TO=
