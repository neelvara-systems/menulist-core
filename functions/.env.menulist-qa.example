# Firebase Functions dotenv template for MenuList staging/QA project menulist-qa.
# Copy to functions/.env.menulist-qa for non-secret runtime env only.
# Store secrets with firebase functions:secrets:set instead.

NEXT_PUBLIC_APP_URL=https://menulist.online
NEXT_PUBLIC_MSG_PREVIEW_BASE_URL=https://menulist.online
# Enable only after real Meta secrets and webhook registration exist.
ENABLE_MESSAGING_ONBOARDING=false
MESSAGING_ONBOARDING_PROVIDERS=whatsapp
ENABLE_MESSAGING_ONBOARDING_TRACKING=true
