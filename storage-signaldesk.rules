rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /signaldesk/imports/{fileName} {
      allow read, write, delete: if false;
    }

    match /signaldesk/evidence/{allPaths=**} {
      allow read, write, delete: if false;
    }

    match /signaldesk/exports/{allPaths=**} {
      allow read, write, delete: if false;
    }

    match /signaldesk/incidents/{allPaths=**} {
      allow read: if isSignalDeskPlatformAdmin();
      allow write, delete: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignalDeskPlatformAdmin() {
      return isAuthenticated()
        && request.auth.token.platformRole == 'PLATFORM';
    }

  }
}
