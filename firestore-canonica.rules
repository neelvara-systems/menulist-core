rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny. Canonica client access is explicitly tenant-scoped below.
    match /{document=**} {
      allow read, write: if false;
    }

    match /platformSummary/{document} {
      allow read: if isAuthenticated()
                  && (isPlatformAdmin()
                      || (
                        isCanonicaPlatformSummaryClientReadableDoc(document)
                        && isCanonicaTenantMember(resource.data)
                        && hasCanonicaPlatformSummaryReadPermission(document)
                      ));
      allow create: if isAuthenticated()
                    && isCanonicaPlatformSummaryDoc(document)
                    && (isPlatformAdmin() || (hasCanonicaPlatformSummaryWritePermission(document) && canCreateCanonicaPlatformSummaryDoc(document)));
      allow update: if isAuthenticated()
                    && isCanonicaPlatformSummaryDoc(document)
                    && (isPlatformAdmin() || (hasCanonicaPlatformSummaryWritePermission(document) && canUpdateCanonicaPlatformSummaryDoc(document)));
      allow delete: if false;
    }

    match /canonica_entities/{docId} {
      allow read: if isCanonicaScopedReadWithKnowledgeControl();
      allow create: if isCanonicaScopedCreateWithKnowledgeControl();
      allow update: if isCanonicaScopedUpdateWithKnowledgeControl();
      allow delete: if false;
    }

    match /canonica_entityRelations/{docId} {
      allow read: if isCanonicaScopedReadWithKnowledgeControl();
      allow create: if isCanonicaScopedCreateWithKnowledgeControl();
      allow update: if isCanonicaScopedUpdateWithKnowledgeControl();
      allow delete: if isCanonicaScopedDeleteWithKnowledgeControl();
    }

    match /canonica_canonicalAnswers/{docId} {
      allow read: if isCanonicaScopedReadWithKnowledgeControl();
      allow create: if isCanonicaScopedCreateWithKnowledgeControl();
      allow update: if isCanonicaScopedUpdateWithKnowledgeControl();
      allow delete: if false;
    }

    match /canonica_releases/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageKnowledge');
      allow create: if isCanonicaScopedCreateWithPermission('canManageKnowledge');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if false;
    }

    match /canonica_mutationProposals/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageGovernance');
      allow create: if isCanonicaScopedCreateWithPermission('canManageGovernance');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageGovernance');
      allow delete: if false;
    }

    match /canonica_signalEvents/{docId} {
      allow read: if isCanonicaScopedReadWithSupportControl();
      allow create: if isCanonicaScopedCreateWithSupportControl();
      allow update: if isCanonicaScopedUpdateWithSupportControl();
      allow delete: if isCanonicaScopedDeleteWithSupportControl();
    }

    match /canonica_auditLogs/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageGovernance');
      allow create: if isCanonicaScopedCreateWithPermission('canManageGovernance');
      allow update, delete: if false;
    }

    match /canonica_entitySearchIndex/{docId} {
      allow read: if isCanonicaScopedReadWithKnowledgeControl();
      allow create: if isCanonicaScopedCreateWithKnowledgeControl();
      allow update: if isCanonicaScopedUpdateWithKnowledgeControl();
      allow delete: if false;
    }

    match /canonica_entityCandidates/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageGovernance');
      allow create: if isCanonicaScopedCreateWithPermission('canManageGovernance');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageGovernance');
      allow delete: if false;
    }

    match /canonica_frictionDailyStats/{docId} {
      allow read: if isCanonicaScopedReadWithReadiness();
      allow write: if false;
    }

    match /canonica_schedulerRunLogs/{docId} {
      allow read: if isAuthenticated() && isPlatformAdmin();
      allow write: if false;
    }

    match /canonica_aiOperations/{tId}/{sId}/{docId} {
      allow read: if isAuthenticated()
        && (isPlatformAdmin() || isCanonicaTenantPath(tId, sId));
      allow write: if false;
    }

    match /canonica_integrationEvents/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageIntegrations');
      allow write: if false;
    }

    match /canonica_integrationDeliveryLogs/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageIntegrations');
      allow write: if false;
    }

    match /canonica_predictiveTriggers/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageGovernance');
      allow create: if isCanonicaScopedCreateWithPermission('canManageGovernance');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageGovernance');
      allow delete: if isCanonicaScopedDeleteWithPermission('canManageGovernance');
    }

    match /canonica_productSurfaces/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageKnowledge');
      allow create: if isCanonicaScopedCreateWithPermission('canManageKnowledge');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if false;
    }

    match /canonica_faqs/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageKnowledge');
      allow create: if isCanonicaScopedCreateWithPermission('canManageKnowledge');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if false;
    }

    match /canonica_supportBoardCards/{docId} {
      allow read: if isCanonicaScopedReadWithSupportControl();
      allow create: if isCanonicaScopedCreateWithSupportControl();
      allow update: if isCanonicaScopedUpdateWithSupportControl();
      allow delete: if false;
    }

    match /canonica_knowledgeIntakeJobs/{docId} {
      allow read: if isCanonicaScopedReadWithKnowledgeControl();
      allow create: if isCanonicaScopedCreateWithKnowledgeControl();
      allow update: if isCanonicaScopedUpdateWithKnowledgeControl();
      allow delete: if false;
    }

    match /canonica_knowledgeSources/{docId} {
      allow read: if isCanonicaScopedReadWithKnowledgeControl();
      allow create: if isCanonicaScopedCreateWithKnowledgeControl();
      allow update: if isCanonicaScopedUpdateWithKnowledgeControl();
      allow delete: if false;
    }

    match /canonica_intakeReviewItems/{docId} {
      allow read: if isCanonicaScopedReadWithKnowledgeControl();
      allow create: if isCanonicaScopedCreateWithKnowledgeControl();
      allow update: if isCanonicaScopedUpdateWithKnowledgeControl();
      allow delete: if false;
    }

    match /canonica_intakeUsageLedger/{docId} {
      allow read: if isCanonicaScopedReadWithKnowledgeControl();
      allow write: if false;
    }

    match /canonica_cacheVersions/{docId} {
      allow read: if isCanonicaScopedReadWithKnowledgeControl()
        || isCanonicaScopedReadWithPermission('canManageWidget');
      allow create: if isCanonicaScopedCreateWithKnowledgeControl()
        || isCanonicaScopedCreateWithPermission('canManageWidget');
      allow update: if isCanonicaScopedUpdateWithKnowledgeControl()
        || isCanonicaScopedUpdateWithPermission('canManageWidget');
      allow delete: if false;
    }

    match /canonica_notificationLogs/{docId} {
      allow read: if isAuthenticated() && isPlatformAdmin();
      allow write: if false;
    }

    match /chatSessions/{docId} {
      allow read: if isCanonicaScopedReadWithSupportControl();
      allow create: if isCanonicaScopedCreateWithSupportControl();
      allow update: if isCanonicaScopedUpdateWithSupportControl();
      allow delete: if isCanonicaScopedDeleteWithSupportControl();
    }

    match /feedback/{docId} {
      allow read: if isCanonicaScopedReadWithSupportControl();
      allow create: if isCanonicaScopedCreateWithSupportControl();
      allow update: if isCanonicaScopedUpdateWithSupportControl();
      allow delete: if false;
    }

    match /supportTickets/{docId} {
      allow read: if isCanonicaScopedReadWithSupportControl();
      allow create: if isCanonicaScopedCreateWithSupportControl();
      allow update: if isCanonicaScopedUpdateWithSupportControl();
      allow delete: if isCanonicaScopedDeleteWithSupportControl();
    }

    match /stores/{storeId} {
      allow read: if isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            string(storeId) == string(request.auth.token.storeId)
            && isCanonicaTenantStoreMember(resource.data)
            && hasAnyCanonicaPermission()
          )
        );
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantStoreMember(resource.data) && hasCanonicaPermission('canManageBilling')));
      allow write: if false;
    }

    match /payment_transactions/{transactionId} {
      allow read: if isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantStoreMember(resource.data) && hasCanonicaPermission('canManageBilling')));
      allow write: if false;
    }

    match /queryEmbeddings/{docId} {
      allow read, write: if false;
    }

    // KB collections can live in the Canonica Firebase project for the
    // founder-onboarding bootstrap. They remain tenant/store-scoped.
    match /kb_categories/{docId} {
      allow read: if isAuthenticated()
        && (isPlatformAdmin() || (kbCategoriesDocMatchesCurrentStore(docId) && hasCanonicaPermission('canManageKnowledge')));
      allow create, update: if isAuthenticated()
        && (isPlatformAdmin() || (hasCanonicaPermission('canManageKnowledge') && kbCategoriesDocMatchesCurrentStore(docId)));
      allow delete: if isAuthenticated() && isPlatformAdmin();
    }

    match /kb_articles/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageKnowledge');
      allow create: if isCanonicaScopedCreateWithPermission('canManageKnowledge');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if isCanonicaScopedDeleteWithPermission('canManageKnowledge');
    }

    match /kb_sections/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageKnowledge');
      allow create: if isCanonicaScopedCreateWithPermission('canManageKnowledge');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if isCanonicaScopedDeleteWithPermission('canManageKnowledge');
    }

    match /kb_generation_jobs/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageKnowledge');
      allow create: if isCanonicaScopedCreateWithPermission('canManageKnowledge');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if isCanonicaScopedDeleteWithPermission('canManageKnowledge');
    }

    match /kb_staging_sections/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageKnowledge');
      allow create: if isCanonicaScopedCreateWithPermission('canManageKnowledge');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if isCanonicaScopedDeleteWithPermission('canManageKnowledge');
    }

    match /kb_staging_chunks/{docId} {
      allow read: if isCanonicaScopedReadWithPermission('canManageKnowledge');
      allow create: if isCanonicaScopedCreateWithPermission('canManageKnowledge');
      allow update: if isCanonicaScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if isCanonicaScopedDeleteWithPermission('canManageKnowledge');
    }

    match /aiSearchHistory/{docId} {
      allow read: if isCanonicaScopedReadWithSupportControl();
      allow create: if isCanonicaScopedCreateWithSupportControl();
      allow update: if isCanonicaScopedUpdateWithSupportControl();
      allow delete: if false;
    }

    match /changelog/{tId}/{sId}/{pageId} {
      allow read: if isAuthenticated()
        && (isPlatformAdmin() || isCanonicaTenantPath(tId, sId));
      allow write: if isAuthenticated()
        && (
          isPlatformAdmin()
          || (hasCanonicaPermission('canManageKnowledge') && isCanonicaTenantPath(tId, sId))
        );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return request.auth != null
        && request.auth.token.platformRole == 'PLATFORM';
    }

    function isCanonicaOwnerRole() {
      return request.auth.token.role == 'OWNER'
        || request.auth.token.role == 'owner';
    }

    function isCanonicaManagerRole() {
      return request.auth.token.role == 'MANAGER'
        || request.auth.token.role == 'manager';
    }

    function isCanonicaStaffRole() {
      return request.auth.token.role == 'STAFF'
        || request.auth.token.role == 'staff';
    }

    function defaultManagerHasCanonicaPermission(permission) {
      return isCanonicaManagerRole()
        && (
          permission == 'canViewReadiness'
          || permission == 'canManageWorkspace'
          || permission == 'canManageTeam'
          || permission == 'canManageKnowledge'
          || permission == 'canManageGovernance'
          || permission == 'canManageWidget'
          || permission == 'canManageSupport'
        );
    }

    function defaultStaffHasCanonicaPermission(permission) {
      return isCanonicaStaffRole() && permission == 'canManageSupport';
    }

    function hasCanonicaPermission(permission) {
      return isPlatformAdmin()
        || request.auth.token.get(permission, false) == true
        || isCanonicaOwnerRole()
        || defaultManagerHasCanonicaPermission(permission)
        || defaultStaffHasCanonicaPermission(permission);
    }

    function hasAnyCanonicaPermission() {
      return hasCanonicaPermission('canViewReadiness')
        || hasCanonicaPermission('canManageWorkspace')
        || hasCanonicaPermission('canManageTeam')
        || hasCanonicaPermission('canAssignRoles')
        || hasCanonicaPermission('canManageBilling')
        || hasCanonicaPermission('canManageKnowledge')
        || hasCanonicaPermission('canManageGovernance')
        || hasCanonicaPermission('canManageWidget')
        || hasCanonicaPermission('canManageSupport')
        || hasCanonicaPermission('canManageIntegrations')
        || hasCanonicaPermission('canExportData')
        || hasCanonicaPermission('canRebuildContext');
    }

    function hasCanonicaReadinessPermission() {
      return hasCanonicaPermission('canViewReadiness')
        || hasCanonicaPermission('canManageKnowledge')
        || hasCanonicaPermission('canManageGovernance')
        || hasCanonicaPermission('canManageWidget')
        || hasCanonicaPermission('canManageIntegrations');
    }

    function hasCanonicaKnowledgeControlPermission() {
      return hasCanonicaPermission('canManageKnowledge')
        || hasCanonicaPermission('canManageGovernance');
    }

    function hasCanonicaSupportControlPermission() {
      return hasCanonicaPermission('canManageSupport')
        || hasCanonicaPermission('canManageWidget');
    }

    function kbCategoriesDocMatchesCurrentStore(docId) {
      return request.auth != null
        && request.auth.token.tenantId != null
        && request.auth.token.storeId != null
        && docId == 'categories_' + string(request.auth.token.tenantId) + '_' + string(request.auth.token.storeId);
    }

    function isCanonicaPlatformSummaryDoc(document) {
      return document.matches('^(branding|coverage|friction|frictionSnapshot|trustMetrics|supportBoardSummary|knowledgeIntakeSummary|entityGraph|interactionRules|predictiveTriggers|contextContent|sourceVersions|bundleManifest|integrationConfig|integrationHealth)_.*$');
    }

    function isCanonicaPlatformSummaryClientReadableDoc(document) {
      return isCanonicaPlatformSummaryDoc(document)
        && !document.matches('^(sourceVersions|bundleManifest)_.*$');
    }

    function isCanonicaSourceVersionsDoc(document) {
      return document.matches('^sourceVersions_.*$');
    }

    function isCanonicaBundleManifestDoc(document) {
      return document.matches('^bundleManifest_.*$');
    }

    function hasCanonicaPlatformSummaryReadPermission(document) {
      return (
          document.matches('^(coverage|friction|frictionSnapshot|trustMetrics)_.*$')
          && hasCanonicaReadinessPermission()
        )
        || (
          document.matches('^supportBoardSummary_.*$')
          && hasCanonicaSupportControlPermission()
        )
        || (
          document.matches('^knowledgeIntakeSummary_.*$')
          && hasCanonicaKnowledgeControlPermission()
        )
        || (
          document.matches('^(entityGraph|interactionRules|predictiveTriggers|contextContent)_.*$')
          && hasCanonicaKnowledgeControlPermission()
        )
        || (
          document.matches('^branding_.*$')
          && (
            hasCanonicaPermission('canManageWidget')
            || hasCanonicaPermission('canManageWorkspace')
            || hasCanonicaKnowledgeControlPermission()
          )
        )
        || (
          document.matches('^(integrationConfig|integrationHealth)_.*$')
          && hasCanonicaPermission('canManageIntegrations')
        );
    }

    function hasCanonicaPlatformSummaryWritePermission(document) {
      return (
          document.matches('^(coverage|friction|frictionSnapshot|trustMetrics)_.*$')
          && hasCanonicaReadinessPermission()
        )
        || (
          document.matches('^(entityGraph|interactionRules|predictiveTriggers|contextContent|sourceVersions|bundleManifest)_.*$')
          && (
            hasCanonicaKnowledgeControlPermission()
            || hasCanonicaPermission('canRebuildContext')
          )
        )
        || (
          document.matches('^knowledgeIntakeSummary_.*$')
          && hasCanonicaKnowledgeControlPermission()
        )
        || (
          document.matches('^branding_.*$')
          && (
            hasCanonicaPermission('canManageWidget')
            || hasCanonicaPermission('canManageWorkspace')
            || hasCanonicaKnowledgeControlPermission()
          )
        )
        || (
          document.matches('^(integrationConfig|integrationHealth)_.*$')
          && hasCanonicaPermission('canManageIntegrations')
        );
    }

    function canonicaSourceVersionClientKeys() {
      return [
        'schemaVersion',
        'pId',
        'tId',
        'sId',
        'workspaceProfile',
        'widgetConfig',
        'kb',
        'docsNav',
        'entities',
        'entityRelations',
        'canonical',
        'surfaces',
        'releases',
        'branding',
        'mcpPolicy',
        'predictiveTriggers',
        'updatedAt',
        'lastReason',
        'lastSourceId',
        'lastSourceType'
      ];
    }

    function canonicaBundleManifestClientKeys() {
      return [
        'schemaVersion',
        'pId',
        'tId',
        'sId',
        'status',
        'staleReason',
        'updatedAt',
        'lastReason',
        'lastSourceId',
        'lastSourceType'
      ];
    }

    function isCanonicaTenantSummaryScopeStable() {
      return isCanonicaTenantMember(resource.data)
        && isCanonicaTenantMember(request.resource.data)
        && request.resource.data.tId == resource.data.tId
        && request.resource.data.sId == resource.data.sId;
    }

    function canCreateCanonicaPlatformSummaryDoc(document) {
      return isCanonicaTenantMember(request.resource.data)
        && (
          (
            isCanonicaSourceVersionsDoc(document)
            && request.resource.data.keys().hasOnly(canonicaSourceVersionClientKeys())
          )
          || (
            isCanonicaBundleManifestDoc(document)
            && request.resource.data.keys().hasOnly(canonicaBundleManifestClientKeys())
            && request.resource.data.status == 'stale'
          )
          || (
            !isCanonicaSourceVersionsDoc(document)
            && !isCanonicaBundleManifestDoc(document)
          )
        );
    }

    function canUpdateCanonicaPlatformSummaryDoc(document) {
      return isCanonicaTenantSummaryScopeStable()
        && (
          (
            isCanonicaSourceVersionsDoc(document)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(canonicaSourceVersionClientKeys())
          )
          || (
            isCanonicaBundleManifestDoc(document)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(canonicaBundleManifestClientKeys())
            && request.resource.data.status == 'stale'
          )
          || (
            !isCanonicaSourceVersionsDoc(document)
            && !isCanonicaBundleManifestDoc(document)
          )
        );
    }

    function isCanonicaTenantMember(data) {
      return request.auth != null
        && data.keys().hasAll(['tId', 'sId'])
        && request.auth.token.tenantId != null
        && request.auth.token.storeId != null
        && string(data.tId) == string(request.auth.token.tenantId)
        && string(data.sId) == string(request.auth.token.storeId);
    }

    function isCanonicaTenantStoreMember(data) {
      return request.auth != null
        && request.auth.token.tenantId != null
        && request.auth.token.storeId != null
        && (
          (
            data.keys().hasAll(['tId', 'sId'])
            && string(data.tId) == string(request.auth.token.tenantId)
            && string(data.sId) == string(request.auth.token.storeId)
          )
          || (
            data.keys().hasAll(['tenantId', 'storeId'])
            && string(data.tenantId) == string(request.auth.token.tenantId)
            && string(data.storeId) == string(request.auth.token.storeId)
          )
        );
    }

    function isCanonicaTenantPath(tId, sId) {
      return request.auth != null
        && request.auth.token.tenantId != null
        && request.auth.token.storeId != null
        && string(tId) == string(request.auth.token.tenantId)
        && string(sId) == string(request.auth.token.storeId);
    }

    function isCanonicaScopedReadWithPermission(permission) {
      return isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantMember(resource.data) && hasCanonicaPermission(permission)));
    }

    function isCanonicaScopedReadWithReadiness() {
      return isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantMember(resource.data) && hasCanonicaReadinessPermission()));
    }

    function isCanonicaScopedReadWithKnowledgeControl() {
      return isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantMember(resource.data) && hasCanonicaKnowledgeControlPermission()));
    }

    function isCanonicaScopedReadWithSupportControl() {
      return isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantMember(resource.data) && hasCanonicaSupportControlPermission()));
    }

    function isCanonicaScopedCreateWithPermission(permission) {
      return isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantMember(request.resource.data) && hasCanonicaPermission(permission)));
    }

    function isCanonicaScopedCreateWithKnowledgeControl() {
      return isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantMember(request.resource.data) && hasCanonicaKnowledgeControlPermission()));
    }

    function isCanonicaScopedCreateWithSupportControl() {
      return isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantMember(request.resource.data) && hasCanonicaSupportControlPermission()));
    }

    function isCanonicaScopedUpdateWithPermission(permission) {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            isCanonicaTenantMember(resource.data)
            && isCanonicaTenantMember(request.resource.data)
            && request.resource.data.tId == resource.data.tId
            && request.resource.data.sId == resource.data.sId
            && hasCanonicaPermission(permission)
          )
        );
    }

    function isCanonicaScopedUpdateWithKnowledgeControl() {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            isCanonicaTenantMember(resource.data)
            && isCanonicaTenantMember(request.resource.data)
            && request.resource.data.tId == resource.data.tId
            && request.resource.data.sId == resource.data.sId
            && hasCanonicaKnowledgeControlPermission()
          )
        );
    }

    function isCanonicaScopedUpdateWithSupportControl() {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            isCanonicaTenantMember(resource.data)
            && isCanonicaTenantMember(request.resource.data)
            && request.resource.data.tId == resource.data.tId
            && request.resource.data.sId == resource.data.sId
            && hasCanonicaSupportControlPermission()
          )
        );
    }

    function isCanonicaScopedDeleteWithPermission(permission) {
      return isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantMember(resource.data) && hasCanonicaPermission(permission)));
    }

    function isCanonicaScopedDeleteWithKnowledgeControl() {
      return isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantMember(resource.data) && hasCanonicaKnowledgeControlPermission()));
    }

    function isCanonicaScopedDeleteWithSupportControl() {
      return isAuthenticated()
        && (isPlatformAdmin() || (isCanonicaTenantMember(resource.data) && hasCanonicaSupportControlPermission()));
    }
  }
}
