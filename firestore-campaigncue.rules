rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /campaigncuePlatformPackTemplates/{categoryId} {
      // The client template registry is intentionally limited to workspace-wide
      // content managers. Branch-scoped and review-only roles use server APIs,
      // where their campaign and location filters can be enforced.
      allow read: if (
          isPlatformAdmin()
          || (
            hasCampaignCueFirebasePurpose('template_read')
            && isCurrentCampaignCueWorkspaceContentManager()
          )
        )
        && isCampaignCuePackTemplateCategoryId(categoryId);
      allow write: if isPlatformAdmin()
        && isCampaignCuePackTemplateCategoryId(categoryId)
        && isValidCampaignCuePlatformPackTemplateCatalog(categoryId);
    }

    // Public campaign pages are served only through the validated Next.js
    // server route. Direct client access remains denied for every visitor.
    match /campaigncuePublicOffers/{slug} {
      allow read, write: if false;
    }

    match /campaigncueWorkspaces/{workspaceId} {
      // Campaign records are read through bounded server APIs. The only direct
      // client Firestore surface is the purpose-scoped template registry below.
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;

      match /businessBrains/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /sourceSnapshots/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /sourceInputs/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /opportunities/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /campaigns/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /assets/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /videoProjects/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /trustReports/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /schedules/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /events/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /analyticsSummaries/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /approvalRequests/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /usageLedger/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /providerConnections/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /packTemplateIndexes/{docId} {
        allow read: if docId == 'default'
          && (
            isPlatformAdmin()
            || hasCampaignCueFirebasePurpose('template_read')
            || hasCampaignCueFirebasePurpose('workspace_template_write')
          )
          && isCampaignCueWorkspaceContentManager(workspaceId);
        allow write: if docId == 'default'
          && (isPlatformAdmin() || hasCampaignCueFirebasePurpose('workspace_template_write'))
          && isCampaignCueWorkspaceContentManager(workspaceId)
          && isValidCampaignCueWorkspacePackTemplateIndex(workspaceId);
      }

      match /locations/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /agencyClientLinks/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /idempotencyKeys/{docId} {
        allow read, write: if false;
      }

      match /cueLayerDesigns/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /cueLayerJobs/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /cueLayerJobEvents/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /cueLayerVersions/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /cueLayerExports/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /cueLayerRepairRequests/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /cueLayerCorrectionEvents/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /cueLayerQualityReports/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /cueLayerCostRecords/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }

      match /cueLayerReviewSamples/{docId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated()
        && request.auth.token.keys().hasAny(['platformRole'])
        && request.auth.token.platformRole == 'PLATFORM';
    }

    function hasCampaignCueFirebasePurpose(purpose) {
      return isAuthenticated()
        && request.auth.token.keys().hasAll(['firebasePurpose'])
        && request.auth.token.firebasePurpose == purpose;
    }

    function currentCampaignCueWorkspaceId() {
      return 'cc_' + string(request.auth.token.tenantId) + '_' + string(request.auth.token.storeId);
    }

    function hasCampaignCueWorkspaceClaims() {
      return isAuthenticated()
        && request.auth.token.keys().hasAll(['tenantId', 'storeId'])
        && request.auth.token.tenantId != null
        && request.auth.token.storeId != null;
    }

    function isCampaignCueWorkspaceMember(workspaceId, data) {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            hasCampaignCueWorkspaceClaims()
            && workspaceId == currentCampaignCueWorkspaceId()
            && isCampaignCueWorkspaceMemberData(workspaceId, data)
          )
        );
    }

    function isCampaignCueWorkspaceMemberById(workspaceId) {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            hasCampaignCueWorkspaceClaims()
            && workspaceId == currentCampaignCueWorkspaceId()
            && exists(/databases/$(database)/documents/campaigncueWorkspaces/$(workspaceId))
            && isCampaignCueWorkspaceMemberData(
              workspaceId,
              get(/databases/$(database)/documents/campaigncueWorkspaces/$(workspaceId)).data
            )
          )
        );
    }

    function isCurrentCampaignCueWorkspaceMember() {
      return hasCampaignCueWorkspaceClaims()
        && isCampaignCueWorkspaceMemberById(currentCampaignCueWorkspaceId());
    }

    function isCurrentCampaignCueWorkspaceContentManager() {
      return hasCampaignCueWorkspaceClaims()
        && isCampaignCueWorkspaceContentManager(currentCampaignCueWorkspaceId());
    }

    function isCampaignCueWorkspaceContentManager(workspaceId) {
      let workspace = get(/databases/$(database)/documents/campaigncueWorkspaces/$(workspaceId)).data;
      return isAuthenticated()
        && (
          (
            request.auth.token.keys().hasAny(['platformRole'])
            && request.auth.token.platformRole == 'PLATFORM'
          )
          || (
          request.auth.token.keys().hasAll(['tenantId', 'storeId'])
          && request.auth.token.tenantId != null
          && request.auth.token.storeId != null
          && workspaceId == currentCampaignCueWorkspaceId()
          && workspace.id == workspaceId
          && workspace.workspaceId == workspaceId
          && workspace.productId == 'CC'
          && string(workspace.tId) == string(request.auth.token.tenantId)
          && string(workspace.sId) == string(request.auth.token.storeId)
          && workspace.status == 'active'
          && workspace.members is map
          && workspace.members.keys().hasAny([request.auth.uid])
          && workspace.members.get(request.auth.uid, {})
            .get('role', '') in ['owner', 'admin', 'marketer', 'agency_member']
          )
        );
    }

    function isCampaignCueWorkspaceMemberData(workspaceId, data) {
      return hasCampaignCueWorkspaceClaims()
        && data.id == workspaceId
        && data.workspaceId == workspaceId
        && data.productId == 'CC'
        && string(data.tId) == string(request.auth.token.tenantId)
        && string(data.sId) == string(request.auth.token.storeId)
        && data.status == 'active'
        && data.members is map
        && data.members.keys().hasAny([request.auth.uid])
        && campaignCueWorkspaceMemberRole(data) in [
          'owner',
          'admin',
          'marketer',
          'reviewer',
          'local_manager',
          'agency_member',
          'billing_admin'
        ];
    }

    function campaignCueWorkspaceMemberRole(data) {
      return data.get('members', {})
        .get(request.auth.uid, {})
        .get('role', '');
    }

    function isCampaignCuePackTemplateCategoryId(categoryId) {
      return categoryId.matches('^(service|retail|food|professional|creative|health|specialty)(_[2-9][0-9]*)?$');
    }

    function isValidCampaignCuePlatformPackTemplateCatalog(categoryId) {
      return request.resource.data.keys().hasAll([
          'businessCategory',
          'catalogId',
          'catalogStatus',
          'data',
          'schemaVersion',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'businessCategory',
          'catalogId',
          'catalogStatus',
          'data',
          'overflowDocIds',
          'schemaVersion',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.businessCategory is string
        && isCampaignCueCatalogForBusinessCategory(
          categoryId,
          request.resource.data.businessCategory
        )
        && request.resource.data.catalogId == categoryId
        && request.resource.data.catalogStatus in ['active', 'hidden']
        && request.resource.data.data is list
        && request.resource.data.data.size() <= 80
        && request.resource.data.updatedAt is number
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.size() <= 120
        && request.resource.data.get('overflowDocIds', []) is list
        && request.resource.data.get('overflowDocIds', []).size() <= 10
        && (
          categoryId == request.resource.data.businessCategory
          || request.resource.data.get('overflowDocIds', []).size() == 0
        );
    }

    function isCampaignCueCatalogForBusinessCategory(categoryId, businessCategory) {
      return (
        businessCategory == 'service'
        && categoryId.matches('^service(_[2-9][0-9]*)?$')
      ) || (
        businessCategory == 'retail'
        && categoryId.matches('^retail(_[2-9][0-9]*)?$')
      ) || (
        businessCategory == 'food'
        && categoryId.matches('^food(_[2-9][0-9]*)?$')
      ) || (
        businessCategory == 'professional'
        && categoryId.matches('^professional(_[2-9][0-9]*)?$')
      ) || (
        businessCategory == 'creative'
        && categoryId.matches('^creative(_[2-9][0-9]*)?$')
      ) || (
        businessCategory == 'health'
        && categoryId.matches('^health(_[2-9][0-9]*)?$')
      ) || (
        businessCategory == 'specialty'
        && categoryId.matches('^specialty(_[2-9][0-9]*)?$')
      );
    }

    function isValidCampaignCueWorkspacePackTemplateIndex(workspaceId) {
      return request.resource.data.keys().hasAll([
          'data',
          'id',
          'schemaVersion',
          'updatedAt',
          'workspaceId'
        ])
        && request.resource.data.keys().hasOnly([
          'data',
          'id',
          'schemaVersion',
          'updatedAt',
          'updatedBy',
          'workspaceId'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.id == 'default'
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.data is list
        && request.resource.data.data.size() <= 100
        && request.resource.data.updatedAt is number
        && request.resource.data.get('updatedBy', '') is string
        && request.resource.data.get('updatedBy', '').size() <= 120;
    }
  }
}
