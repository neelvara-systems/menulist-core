rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /campaigncue/assets/{workspaceId}/{uploadId}/{fileName} {
      // Upload sessions are bound to one immutable folder. Reading is served by
      // the bounded preview/download APIs, never by a reusable Firebase token.
      allow read: if false;
      allow create: if isCampaignCueWorkspaceContentManager(workspaceId)
        && hasCampaignCueMediaUploadScope(uploadId)
        && resource == null
        && request.resource.metadata is map
        && request.resource.metadata.keys().hasAll(['uploadedBy'])
        && request.resource.metadata.keys().hasOnly(['uploadedBy'])
        && request.resource.metadata.uploadedBy == request.auth.uid
        && isCampaignCueMediaUploadArtifact(fileName);
      allow update: if false;
      allow delete: if isCampaignCueWorkspaceContentManager(workspaceId)
        && hasCampaignCueMediaUploadScope(uploadId)
        && resource.metadata is map
        && resource.metadata.keys().hasAll(['uploadedBy'])
        && resource.metadata.uploadedBy == request.auth.uid
        && isCampaignCueMediaUploadFileName(fileName);
    }

    match /campaigncue/renders/{workspaceId}/{allPaths=**} {
      allow read, write, delete: if false;
    }

    match /campaigncue/reports/{workspaceId}/{allPaths=**} {
      // Report exports are uploaded and downloaded only through short-lived,
      // server-issued signed URLs. No Firebase client receives direct access.
      allow read, write, delete: if false;
    }

    match /campaigncue/templates/platform/shared/{templateId}/{fileName} {
      allow read: if isPlatformAdmin()
        || (
          hasCampaignCueFirebasePurpose('template_read')
          && isCurrentCampaignCueWorkspaceContentManager()
        );
      allow create: if isPlatformAdmin()
        && resource == null
        && isCampaignCueTemplateArtifactName(fileName)
        && isCampaignCueTemplateArtifactType()
        && request.resource.size <= 750 * 1024;
      allow update, delete: if false;
    }

    match /campaigncue/templates/platform/{categoryId}/{templateId}/{fileName} {
      allow read: if (
          isPlatformAdmin()
          || (
            hasCampaignCueFirebasePurpose('template_read')
            && isCurrentCampaignCueWorkspaceContentManager()
          )
        )
        && isCampaignCuePackTemplateCategoryId(categoryId);
      allow create: if isPlatformAdmin()
        && resource == null
        && isCampaignCuePackTemplateCategoryId(categoryId)
        && isCampaignCueTemplateArtifactName(fileName)
        && isCampaignCueTemplateArtifactType()
        && request.resource.size <= 750 * 1024;
      allow update, delete: if false;
    }

    match /campaigncue/templates/workspaces/{workspaceId}/{templateId}/{fileName} {
      allow read: if (isPlatformAdmin() || hasCampaignCueFirebasePurpose('template_read'))
        && isCampaignCueWorkspaceContentManager(workspaceId);
      allow create: if (isPlatformAdmin() || hasCampaignCueFirebasePurpose('workspace_template_write'))
        && isCampaignCueWorkspaceContentManager(workspaceId)
        && resource == null
        && isCampaignCueWorkspaceTemplateArtifactName(fileName)
        && isCampaignCueTemplateArtifactType()
        && request.resource.size <= 750 * 1024;
      allow update: if false;
      allow delete: if (isPlatformAdmin() || hasCampaignCueFirebasePurpose('workspace_template_write'))
        && isCampaignCueWorkspaceContentManager(workspaceId)
        && isCampaignCueWorkspaceTemplateArtifactName(fileName);
    }

    match /campaigncue/templates/workspaces/{workspaceId}/{templateId}/versions/{versionId}/{fileName} {
      allow read: if (isPlatformAdmin() || hasCampaignCueFirebasePurpose('template_read'))
        && isCampaignCueWorkspaceContentManager(workspaceId)
        && isCampaignCueWorkspaceTemplateVersionId(versionId);
      allow create: if (isPlatformAdmin() || hasCampaignCueFirebasePurpose('workspace_template_write'))
        && isCampaignCueWorkspaceContentManager(workspaceId)
        && resource == null
        && isCampaignCueWorkspaceTemplateVersionId(versionId)
        && isCampaignCueWorkspaceTemplateArtifactName(fileName)
        && isCampaignCueTemplateArtifactType()
        && request.resource.size <= 750 * 1024;
      allow update: if false;
      allow delete: if (isPlatformAdmin() || hasCampaignCueFirebasePurpose('workspace_template_write'))
        && isCampaignCueWorkspaceContentManager(workspaceId)
        && isCampaignCueWorkspaceTemplateVersionId(versionId)
        && isCampaignCueWorkspaceTemplateArtifactName(fileName);
    }

    match /campaigncue/cue-layers/{workspaceId}/{designId}/{allPaths=**} {
      allow read, write, delete: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated()
        && request.auth.token.keys().hasAny(['platformRole'])
        && request.auth.token.platformRole == 'PLATFORM';
    }

    function hasCampaignCueFirebasePurpose(purpose) {
      return isAuthenticated()
        && request.auth.token.keys().hasAll(['firebasePurpose'])
        && request.auth.token.firebasePurpose == purpose;
    }

    function hasCampaignCueMediaUploadScope(uploadId) {
      return hasCampaignCueFirebasePurpose('media_upload')
        && request.auth.token.keys().hasAll(['mediaSourceFileName', 'mediaUploadId'])
        && request.auth.token.mediaUploadId == uploadId;
    }

    function currentCampaignCueWorkspaceId() {
      return 'cc_' + string(request.auth.token.tenantId) + '_' + string(request.auth.token.storeId);
    }

    function hasCampaignCueWorkspaceClaims() {
      return isAuthenticated()
        && request.auth.token.keys().hasAll(['tenantId', 'storeId'])
        && request.auth.token.tenantId != null
        && request.auth.token.storeId != null;
    }

    function isCampaignCueWorkspaceMember(workspaceId) {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            hasCampaignCueWorkspaceClaims()
            && workspaceId == currentCampaignCueWorkspaceId()
            && isCampaignCueWorkspaceMemberData(
              workspaceId,
              firestore.get(
                /databases/(default)/documents/campaigncueWorkspaces/$(workspaceId)
              ).data
            )
          )
        );
    }

    function isCurrentCampaignCueWorkspaceMember() {
      return hasCampaignCueWorkspaceClaims()
        && isCampaignCueWorkspaceMember(currentCampaignCueWorkspaceId());
    }

    function isCurrentCampaignCueWorkspaceContentManager() {
      return hasCampaignCueWorkspaceClaims()
        && isCampaignCueWorkspaceContentManager(currentCampaignCueWorkspaceId());
    }

    function isCampaignCueWorkspaceContentManager(workspaceId) {
      let workspace = firestore.get(
        /databases/(default)/documents/campaigncueWorkspaces/$(workspaceId)
      ).data;
      return isAuthenticated()
        && (
          (
            request.auth.token.keys().hasAny(['platformRole'])
            && request.auth.token.platformRole == 'PLATFORM'
          )
          || (
          request.auth.token.keys().hasAll(['tenantId', 'storeId'])
          && request.auth.token.tenantId != null
          && request.auth.token.storeId != null
          && workspaceId == currentCampaignCueWorkspaceId()
          && workspace.id == workspaceId
          && workspace.workspaceId == workspaceId
          && workspace.productId == 'CC'
          && string(workspace.tId) == string(request.auth.token.tenantId)
          && string(workspace.sId) == string(request.auth.token.storeId)
          && workspace.status == 'active'
          && workspace.members is map
          && workspace.members.keys().hasAny([request.auth.uid])
          && workspace.members.get(request.auth.uid, {})
            .get('role', '') in ['owner', 'admin', 'marketer', 'agency_member']
          )
        );
    }

    function isCampaignCueWorkspaceMemberData(workspaceId, data) {
      return hasCampaignCueWorkspaceClaims()
        && data.id == workspaceId
        && data.workspaceId == workspaceId
        && data.productId == 'CC'
        && string(data.tId) == string(request.auth.token.tenantId)
        && string(data.sId) == string(request.auth.token.storeId)
        && data.status == 'active'
        && data.members is map
        && data.members.keys().hasAny([request.auth.uid])
        && campaignCueWorkspaceMemberRole(data) in [
          'owner',
          'admin',
          'marketer',
          'reviewer',
          'local_manager',
          'agency_member',
          'billing_admin'
        ];
    }

    function campaignCueWorkspaceMemberRole(data) {
      return data.get('members', {})
        .get(request.auth.uid, {})
        .get('role', '');
    }

    function isCampaignCuePackTemplateCategoryId(categoryId) {
      return categoryId.matches('^(service|retail|food|professional|creative|health|specialty)$');
    }

    function isCampaignCueMediaUploadFileName(fileName) {
      return fileName == 'preview.webp'
        || fileName == request.auth.token.mediaSourceFileName;
    }

    function isCampaignCueMediaUploadArtifact(fileName) {
      return isCampaignCueMediaUploadFileName(fileName)
        && (
          (
            fileName == 'preview.webp'
            && request.resource.contentType == 'image/webp'
            && request.resource.size <= 1024 * 1024
          ) || (
            fileName == request.auth.token.mediaSourceFileName
            && fileName.matches('^source\\.[a-z0-9]{1,8}$')
            && isCampaignCueSourceMediaTypeAndSizeAllowed()
          )
        );
    }

    function isCampaignCueSourceMediaTypeAndSizeAllowed() {
      return (
          request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          && request.resource.size <= 12 * 1024 * 1024
        ) || (
          request.resource.contentType.matches('video/(mp4|quicktime|webm)')
          && request.resource.size <= 250 * 1024 * 1024
        ) || (
          request.resource.contentType.matches('audio/(mpeg|mp4|wav|ogg|webm)')
          && request.resource.size <= 50 * 1024 * 1024
        );
    }

    function isCampaignCueTemplateArtifactType() {
      return request.resource.contentType.matches('application/json')
        || request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isCampaignCueTemplateArtifactName(fileName) {
      return fileName.matches('^(pack-template|editor-document)(-[a-f0-9]{16,64})?\\.json$')
        || fileName.matches('^preview(-[a-f0-9]{16,64})?\\.(png|jpeg|webp)$');
    }

    function isCampaignCueWorkspaceTemplateArtifactName(fileName) {
      return fileName.matches('^(pack-template\\.json|editor-document\\.json|preview\\.(png|jpeg|webp))$');
    }

    function isCampaignCueWorkspaceTemplateVersionId(versionId) {
      return versionId.matches('^[a-zA-Z0-9_-]{3,160}$');
    }
  }
}
