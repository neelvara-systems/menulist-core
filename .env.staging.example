PLATFORM_ALERT_WHATSAPP_SESSION_ACTIVE=false
TELEGRAM_BOT_TOKEN=<staging-telegram-bot-token>
TELEGRAM_CHAT_ID=<staging-telegram-chat-id>
SLACK_WEBHOOK_URL=

# WhatsApp, phone OTP, and messaging onboarding
MENULIST_WHATSAPP_PHONE_NUMBER_ID=
MENULIST_WHATSAPP_ACCESS_TOKEN=
MENULIST_WHATSAPP_APP_SECRET=
MENULIST_WHATSAPP_VERIFY_TOKEN=
# Current MenuList runtime compatibility aliases.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
