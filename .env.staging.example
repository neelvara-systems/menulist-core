# Vercel Preview/Staging env for the shared MenuList + Answerlattice + CampaignCue + MyCodex app.
# Copy these keys into Vercel with the Preview scope. Do not commit real values.
# Env variable keys intentionally use full product names. Do not shorten to AL_*, CC_*, or MC_*.

# Runtime identity
NEXT_PUBLIC_ENV=preview
NEXT_PUBLIC_APP_URL=https://menulist.online
NEXT_PUBLIC_PLATFORM_DOMAIN=menulist.online
NEXT_PUBLIC_PLATFORM_DOMAIN_ALIASES=menulist.online,www.menulist.online

# Auth
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# Optional. Prefer Vercel's runtime URL detection unless OAuth callback behavior requires pinning.
# NEXTAUTH_URL=https://menulist.online

# MenuList Firebase - staging uses ecomsai
NEXT_PUBLIC_FIREBASE_API_KEY=<ecomsai-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<ecomsai-auth-domain>
NEXT_PUBLIC_FB_DATABASE_URL=<ecomsai-realtime-database-url>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ecomsai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<ecomsai-storage-bucket>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<ecomsai-messaging-sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<ecomsai-web-app-id>
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=<ecomsai-ga-measurement-id>
FIREBASE_PROJECT_ID=ecomsai
FIREBASE_CLIENT_EMAIL=<ecomsai-service-account-client-email>
FIREBASE_PRIVATE_KEY=<ecomsai-service-account-private-key-with-escaped-newlines>
FIREBASE_PROJECT_LOCATION=us-central1

# Answerlattice Firebase - staging uses answerlattice-qa
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_MODE=separate
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_API_KEY=<answerlattice-qa-web-api-key>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_AUTH_DOMAIN=<answerlattice-qa-auth-domain>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_PROJECT_ID=answerlattice-qa
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_STORAGE_BUCKET=<answerlattice-qa-storage-bucket>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_MESSAGING_SENDER_ID=<answerlattice-qa-messaging-sender-id>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_APP_ID=<answerlattice-qa-web-app-id>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_MEASUREMENT_ID=<answerlattice-qa-ga-measurement-id>
# Leave blank unless using a named Firestore database.
NEXT_PUBLIC_ANSWERLATTICE_FIRESTORE_DATABASE_ID=
ANSWERLATTICE_FIREBASE_MODE=separate
ANSWERLATTICE_FIREBASE_PROJECT_ID=answerlattice-qa
ANSWERLATTICE_FIREBASE_STORAGE_BUCKET=<answerlattice-qa-storage-bucket>
ANSWERLATTICE_FIREBASE_CLIENT_EMAIL=<answerlattice-qa-service-account-client-email>
ANSWERLATTICE_FIREBASE_PRIVATE_KEY=<answerlattice-qa-service-account-private-key-with-escaped-newlines>
ANSWERLATTICE_FIRESTORE_DATABASE_ID=
ANSWERLATTICE_CRON_SECRET=<shared-with-answerlattice-functions-secret>
ANSWERLATTICE_MCP_SESSION_SECRET=<generate-with-openssl-rand-base64-32>
ANSWERLATTICE_PUBLIC_BUNDLE_SALT=<generate-random-salt>
ANSWERLATTICE_NIGHTLY_TRIGGER_URL=<answerlattice-qa-manual-scheduler-url>
ANSWERLATTICE_TRIGGER_NIGHTLY_URL=<answerlattice-qa-manual-scheduler-url>

# CampaignCue Firebase - staging uses campaigncue-qa
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_MODE=separate
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_API_KEY=<campaigncue-qa-web-api-key>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_AUTH_DOMAIN=<campaigncue-qa-auth-domain>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_PROJECT_ID=campaigncue-qa
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_STORAGE_BUCKET=<campaigncue-qa-storage-bucket>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_MESSAGING_SENDER_ID=<campaigncue-qa-messaging-sender-id>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_APP_ID=<campaigncue-qa-web-app-id>
NEXT_PUBLIC_CAMPAIGNCUE_FIRESTORE_DATABASE_ID=
CAMPAIGNCUE_FIREBASE_MODE=separate
CAMPAIGNCUE_FIREBASE_PROJECT_ID=campaigncue-qa
CAMPAIGNCUE_FIREBASE_STORAGE_BUCKET=<campaigncue-qa-storage-bucket>
CAMPAIGNCUE_FIREBASE_CLIENT_EMAIL=<campaigncue-qa-service-account-client-email>
CAMPAIGNCUE_FIREBASE_PRIVATE_KEY=<campaigncue-qa-service-account-private-key-with-escaped-newlines>
CAMPAIGNCUE_FIRESTORE_DATABASE_ID=

# AI
GEMINI_AI_KEY=<google-ai-studio-or-vertex-compatible-gemini-key>
GEMINI_AI_KEY_2=
GEMINI_AI_KEY_3=
GEMINI_AI_KEY_4=

# Payments - use Razorpay test mode in staging
RAZORPAY_KEY_ID=rzp_test_<id>
RAZORPAY_KEY_SECRET=<razorpay-test-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-test-webhook-secret>
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_<id>

# Rate limiting and caches
UPSTASH_REDIS_REST_URL=<staging-upstash-rest-url>
UPSTASH_REDIS_REST_TOKEN=<staging-upstash-rest-token>

# Public cache revalidation shared between Vercel and Firebase Functions
REVALIDATION_SECRET=<same-value-in-vercel-and-firebase-secret-manager>

# Google Cloud Tasks batch image generation
BATCH_IMAGE_GENERATION_WORKER_URL=<staging-worker-url>
BATCH_IMAGE_GENERATION_QUEUE_ID=<staging-queue-id>
BATCH_IMAGE_GENERATION_WORKER_SECRET=<staging-worker-secret>

# Analytics and website measurement
GA_CLIENT_EMAIL=<ga4-service-account-email>
GA_PRIVATE_KEY=<ga4-private-key-with-escaped-newlines>
GA_PROJECT_ID=<ga4-gcp-project-id>
NEXT_PUBLIC_GA_MEASUREMENT_ID=<staging-ga-measurement-id>
NEXT_PUBLIC_CLARITY_ID=<staging-clarity-id>
NEXT_PUBLIC_UNSPLASH_API_CLIENTID=
NEXT_PUBLIC_PIXABAY_API_CLIENTID=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Sentry
SENTRY_DSN=<staging-or-dev-sentry-server-dsn>
NEXT_PUBLIC_SENTRY_DEV_DSN=<staging-sentry-browser-dsn>
NEXT_PUBLIC_SENTRY_DSN=<staging-sentry-browser-dsn>
SENTRY_AUTH_TOKEN=<sentry-source-map-upload-token>
SENTRY_ORG=<sentry-org-slug>
SENTRY_PROJECT=<sentry-project-slug>

# Firebase App Check / reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<staging-recaptcha-v3-site-key>
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Email and internal recipients
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<staging-sender-email>
SMTP_PASS=<staging-app-password>
INTERNAL_NOTIFICATION_EMAIL=<ops-email>
INTERNAL_BILLING_EMAIL=<billing-email>
PLATFORM_ALERT_EMAIL_TO=<ops-email>

# Ops alerts and messaging channels
TELEGRAM_BOT_TOKEN=<staging-telegram-bot-token>
TELEGRAM_CHAT_ID=<staging-telegram-chat-id>
PLATFORM_ALERT_WHATSAPP_TO=
PLATFORM_ALERT_WHATSAPP_TEMPLATE_NAME=
PLATFORM_ALERT_WHATSAPP_TEMPLATE_LANGUAGE=en_US
PLATFORM_ALERT_WHATSAPP_SESSION_ACTIVE=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
MESSAGING_ONBOARDING_PROVIDERS=whatsapp

# MenuList owner app Answerlattice widget embed
NEXT_PUBLIC_MENULIST_ANSWERLATTICE_WIDGET_KEY=
NEXT_PUBLIC_MENULIST_ANSWERLATTICE_WIDGET_SCRIPT_SRC=

# MyCodex internal docs route protection. Required on Vercel by env validation.
MYCODEX_BASIC_AUTH_USER=<internal-docs-username>
MYCODEX_BASIC_AUTH_PASSWORD=<internal-docs-password>
MYCODEX_SESSION_SECRET=<generate-with-openssl-rand-base64-32>

# Optional legacy/future integrations
SLACK_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=
