# Keep Functions processing off until real Meta secrets and webhook registration exist.
ENABLE_MESSAGING_ONBOARDING=false
MESSAGING_ONBOARDING_PROVIDERS=whatsapp
ENABLE_MESSAGING_ONBOARDING_TRACKING=true
NEXT_PUBLIC_MSG_PREVIEW_BASE_URL=https://menulist.online

# MenuList owner app Answerlattice widget embed
NEXT_PUBLIC_MENULIST_ANSWERLATTICE_WIDGET_KEY=
NEXT_PUBLIC_MENULIST_ANSWERLATTICE_WIDGET_SCRIPT_SRC=https://answerlattice.menulist.online/widget/v1/answerlattice-widget.js

# Menu link import browser controls
MENU_LINK_IMPORT_CHROME_PATH=
MENU_LINK_IMPORT_CHROME_NO_SANDBOX=false

# Vercel Domains API - only needed when domain automation is enabled
# Vercel auto-provides VERCEL, VERCEL_ENV, VERCEL_URL, and commit metadata.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional webhook verification secrets
GITHUB_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=
