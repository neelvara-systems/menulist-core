# Final env template - Local + Staging
# Use this as the complete key inventory for .env.local and Vercel Preview/Staging.
# It is not deployable as-is, and Vercel does not read this file automatically.
# Local and staging intentionally share the same QA Firebase projects.
# Do not commit real values.
# Never upload or run with literal <...> placeholders. During the MenuList-only
# setup, populate MenuList/shared runtime rows and omit unrelated product rows
# from the actual local/Vercel environment until those products are configured.
#
# Env variable names use full product names only:
# MENULIST_*, ANSWERLATTICE_*, CAMPAIGNCUE_*, SIGNALDESK_*, NEELVARA_*, MYCODEX_*.
# ML, AL, CC, MC, and SD are internal product codes, not env prefixes.
# Neelvara is a static parent site target and does not reserve an env prefix beyond NEELVARA_*.

# Runtime identity and routing
NEXT_PUBLIC_ENV=preview
NEXT_PUBLIC_VERCEL_ENV=preview
NEXT_PUBLIC_APP_URL=https://menulist.digital
NEXT_PUBLIC_DEPLOYMENT_URL=https://menulist.digital
NEXT_PUBLIC_PLATFORM_DOMAIN=menulist.digital
NEXT_PUBLIC_PLATFORM_DOMAIN_ALIASES=menulist.digital,www.menulist.digital,app.menulist.digital
NEXT_PUBLIC_MENULIST_TENANT_BASE_DOMAIN=menulist.digital
NEXT_PUBLIC_BUILD_ID=
NEXT_PUBLIC_BUILD_CREATED_AT=
NEXT_PUBLIC_ENABLE_DEPLOYMENT_BUILD_BADGE=false
# Local-only URL override when needed:
# NEXT_PUBLIC_ENV=development
# NEXT_PUBLIC_VERCEL_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# Auth
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
# MenuList QA Google OAuth client.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# Answerlattice QA Google OAuth client for canonica.app.
ANSWERLATTICE_GOOGLE_CLIENT_ID=<answerlattice-qa-google-oauth-client-id>
ANSWERLATTICE_GOOGLE_CLIENT_SECRET=<answerlattice-qa-google-oauth-client-secret>
# Do not set NEXTAUTH_URL in the shared hosted Vercel environment. NextAuth must
# derive the exact request origin so host-only sessions and product OAuth
# callbacks stay on app.menulist.digital or canonica.app. Localhost may set it.

# Owner referral token encryption. Required before ENABLE_OWNER_REFERRAL is enabled.
# Generate an unpadded 32-byte base64url value, for example with Node crypto.
MENULIST_OWNER_REFERRAL_TOKEN_SECRET=<generate-32-byte-base64url-secret>

# MenuList Firebase - Vercel custom qa environment uses menulist-qa.
# Local development may override the Admin mode to adc; never copy a private key into Vercel.
NEXT_PUBLIC_MENULIST_FIREBASE_API_KEY=<menulist-qa-web-api-key>
NEXT_PUBLIC_MENULIST_FIREBASE_AUTH_DOMAIN=<menulist-qa-auth-domain>
NEXT_PUBLIC_MENULIST_FB_DATABASE_URL=<menulist-qa-realtime-database-url>
NEXT_PUBLIC_MENULIST_FIREBASE_PROJECT_ID=menulist-qa
NEXT_PUBLIC_MENULIST_FIREBASE_STORAGE_BUCKET=<menulist-qa-storage-bucket>
NEXT_PUBLIC_MENULIST_FIREBASE_MESSAGING_SENDER_ID=<menulist-qa-messaging-sender-id>
NEXT_PUBLIC_MENULIST_FIREBASE_APP_ID=<menulist-qa-web-app-id>
NEXT_PUBLIC_MENULIST_FIREBASE_MEASUREMENT_ID=<menulist-qa-ga-measurement-id>
MENULIST_FIREBASE_ADMIN_AUTH_MODE=vercel_oidc
MENULIST_GCP_PROJECT_NUMBER=<menulist-qa-project-number>
MENULIST_GCP_SERVICE_ACCOUNT_EMAIL=menulist-vercel-qa@menulist-qa.iam.gserviceaccount.com
MENULIST_GCP_WORKLOAD_IDENTITY_POOL_ID=menulist-vercel
MENULIST_GCP_WORKLOAD_IDENTITY_PROVIDER_ID=menulist-qa
MENULIST_FIREBASE_PROJECT_LOCATION=us-central1

# Answerlattice Firebase - Vercel custom qa environment uses neelvara-answerlattice-qa.
# Local development may override the Admin mode to adc; never copy a private key into Vercel.
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_MODE=separate
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_API_KEY=<answerlattice-qa-web-api-key>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_AUTH_DOMAIN=<answerlattice-qa-auth-domain>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_PROJECT_ID=neelvara-answerlattice-qa
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_STORAGE_BUCKET=<answerlattice-qa-storage-bucket>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_MESSAGING_SENDER_ID=<answerlattice-qa-messaging-sender-id>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_APP_ID=<answerlattice-qa-web-app-id>
NEXT_PUBLIC_ANSWERLATTICE_FIREBASE_MEASUREMENT_ID=<answerlattice-qa-ga-measurement-id>
NEXT_PUBLIC_ANSWERLATTICE_RECAPTCHA_SITE_KEY=<answerlattice-qa-recaptcha-v3-site-key>
NEXT_PUBLIC_ANSWERLATTICE_FIRESTORE_DATABASE_ID=
ANSWERLATTICE_FIREBASE_ADMIN_AUTH_MODE=vercel_oidc
ANSWERLATTICE_GCP_PROJECT_NUMBER=<answerlattice-qa-project-number>
ANSWERLATTICE_GCP_SERVICE_ACCOUNT_EMAIL=answerlattice-vercel-qa@neelvara-answerlattice-qa.iam.gserviceaccount.com
ANSWERLATTICE_GCP_WORKLOAD_IDENTITY_POOL_ID=answerlattice-vercel
ANSWERLATTICE_GCP_WORKLOAD_IDENTITY_PROVIDER_ID=answerlattice-qa
ANSWERLATTICE_CRON_SECRET=<shared-with-answerlattice-functions-secret>
ANSWERLATTICE_GEMINI_AI_KEY=<answerlattice-qa-gemini-api-key>
# Local admission ceiling; keep below the active AI Studio project limit.
ANSWERLATTICE_GEMINI_SPEND_LIMIT_USD_10M=8
ANSWERLATTICE_UPSTASH_REDIS_REST_URL=
ANSWERLATTICE_UPSTASH_REDIS_REST_TOKEN=
ANSWERLATTICE_MCP_SESSION_SECRET=<generate-with-openssl-rand-base64-32>
ANSWERLATTICE_GITHUB_APP_ID=<github-app-id>
ANSWERLATTICE_GITHUB_APP_SLUG=<github-app-slug>
ANSWERLATTICE_GITHUB_APP_PRIVATE_KEY=<github-app-private-key-with-escaped-newlines>
ANSWERLATTICE_GITHUB_APP_CLIENT_ID=<github-app-client-id>
ANSWERLATTICE_GITHUB_APP_CLIENT_SECRET=<github-app-client-secret>
ANSWERLATTICE_GITHUB_WEBHOOK_SECRET=<generate-with-openssl-rand-base64-32>
ANSWERLATTICE_GITHUB_STATE_SECRET=<generate-with-openssl-rand-base64-32>
ANSWERLATTICE_WIDGET_RUNTIME_SECRET=<generate-with-openssl-rand-base64-32>
ANSWERLATTICE_PUBLIC_BUNDLE_SALT=<generate-random-salt>
ANSWERLATTICE_NIGHTLY_TRIGGER_URL=<answerlattice-qa-manual-scheduler-url>
ANSWERLATTICE_TRIGGER_NIGHTLY_URL=<answerlattice-qa-manual-scheduler-url>
ANSWERLATTICE_PUBLIC_API_DEBUG=false
ANSWERLATTICE_TEST_URL=https://canonica.app
NEXT_PUBLIC_ANSWERLATTICE_WIDGET_KEY=<answerlattice-qa-public-widget-key>

# CampaignCue Firebase - local/staging uses campaigncue-qa
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_MODE=separate
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_API_KEY=<campaigncue-qa-web-api-key>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_AUTH_DOMAIN=<campaigncue-qa-auth-domain>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_PROJECT_ID=campaigncue-qa
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_STORAGE_BUCKET=<campaigncue-qa-storage-bucket>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_MESSAGING_SENDER_ID=<campaigncue-qa-messaging-sender-id>
NEXT_PUBLIC_CAMPAIGNCUE_FIREBASE_APP_ID=<campaigncue-qa-web-app-id>
NEXT_PUBLIC_CAMPAIGNCUE_FIRESTORE_DATABASE_ID=
CAMPAIGNCUE_FIREBASE_CLIENT_EMAIL=<campaigncue-qa-service-account-client-email>
CAMPAIGNCUE_FIREBASE_PRIVATE_KEY=<campaigncue-qa-service-account-private-key-with-escaped-newlines>
CAMPAIGNCUE_GOOGLE_APPLICATION_CREDENTIALS=

# CampaignCue CueLayers model registry
# Premium accepts an explicit true/false gate. Leave the segmentation model ID
# blank to disable it. Rollouts are clamped to 0-100 and 0 selects no traffic.
CAMPAIGNCUE_CUE_LAYERS_LOW_COST_IMAGE_MODEL=
CAMPAIGNCUE_CUE_LAYERS_ENABLE_PREMIUM_MODEL=false
CAMPAIGNCUE_CUE_LAYERS_PREMIUM_IMAGE_MODEL=
CAMPAIGNCUE_CUE_LAYERS_PREMIUM_ROLLOUT_PERCENT=0
CAMPAIGNCUE_CUE_LAYERS_SEGMENTATION_MODEL=
CAMPAIGNCUE_CUE_LAYERS_SEGMENTATION_ROLLOUT_PERCENT=0
CAMPAIGNCUE_TEMPLATE_SEED_ACTOR=campaigncue-template-seed

# SignalDesk - local/staging uses its separate menulist-signaldesk-qa project
NEXT_PUBLIC_SIGNALDESK_FIREBASE_MODE=separate
NEXT_PUBLIC_SIGNALDESK_FIREBASE_API_KEY=<menulist-signaldesk-qa-web-api-key>
NEXT_PUBLIC_SIGNALDESK_FIREBASE_AUTH_DOMAIN=<menulist-signaldesk-qa-auth-domain>
NEXT_PUBLIC_SIGNALDESK_FIREBASE_PROJECT_ID=menulist-signaldesk-qa
NEXT_PUBLIC_SIGNALDESK_FIREBASE_STORAGE_BUCKET=menulist-signaldesk-qa.firebasestorage.app
NEXT_PUBLIC_SIGNALDESK_FIREBASE_MESSAGING_SENDER_ID=<menulist-signaldesk-qa-messaging-sender-id>
NEXT_PUBLIC_SIGNALDESK_FIREBASE_APP_ID=<menulist-signaldesk-qa-web-app-id>
NEXT_PUBLIC_SIGNALDESK_FIRESTORE_DATABASE_ID=
SIGNALDESK_FIREBASE_MODE=separate
SIGNALDESK_FIREBASE_PROJECT_ID=menulist-signaldesk-qa
SIGNALDESK_FIREBASE_STORAGE_BUCKET=menulist-signaldesk-qa.firebasestorage.app
SIGNALDESK_FIREBASE_CLIENT_EMAIL=<menulist-signaldesk-qa-service-account-client-email>
SIGNALDESK_FIREBASE_PRIVATE_KEY=<menulist-signaldesk-qa-service-account-private-key-with-escaped-newlines>
SIGNALDESK_GOOGLE_APPLICATION_CREDENTIALS=
SIGNALDESK_FIRESTORE_DATABASE_ID=
SIGNALDESK_GEMINI_AI_KEY=<menulist-signaldesk-qa-gemini-api-key>
SIGNALDESK_GEMINI_AI_KEY_2=
SIGNALDESK_GEMINI_AI_KEY_3=
SIGNALDESK_GEMINI_AI_KEY_4=
SIGNALDESK_GEMINI_SPEND_LIMIT_USD_10M=8
SIGNALDESK_AI_MODEL=
SIGNALDESK_OUTCOME_BRIDGE_SECRET=<signaldesk-qa-outcome-bridge-hmac-secret>
# Optional SignalDesk source/send providers. Leave blank until the matching provider
# account, legal approval, budget cap, and provider-send gate are explicitly approved.
SIGNALDESK_APIFY_API_TOKEN=
SIGNALDESK_APIFY_SOURCE_ACTOR_ID=
SIGNALDESK_APIFY_WEBHOOK_SECRET=
SIGNALDESK_GOOGLE_PLACES_API_KEY=
SIGNALDESK_META_ACCESS_TOKEN=
SIGNALDESK_META_APP_SECRET=
SIGNALDESK_META_VERIFY_TOKEN=
SIGNALDESK_MESSENGER_PAGE_ID=
SIGNALDESK_INSTAGRAM_PAGE_ID=
SIGNALDESK_WHATSAPP_PHONE_NUMBER_ID=
SIGNALDESK_EMAIL_FROM=
SIGNALDESK_EMAIL_REPLY_TO=
SIGNALDESK_EMAIL_WEBHOOK_SECRET=
SIGNALDESK_SMTP_HOST=
SIGNALDESK_SMTP_PORT=
SIGNALDESK_SMTP_SECURE=false
SIGNALDESK_SMTP_USER=
SIGNALDESK_SMTP_PASS=
SIGNALDESK_UNSUBSCRIBE_URL=
SIGNALDESK_PHYSICAL_ADDRESS=
SIGNALDESK_SMARTLEAD_API_KEY=
SIGNALDESK_SMARTLEAD_WEBHOOK_SECRET=

# Static products
# MyCodex is static/no DB. Do not add Firebase, billing, Storage, or Functions env keys.
# Neelvara is static/no DB. These public values only control displayed mailto links and structured data.
NEXT_PUBLIC_NEELVARA_CONTACT_EMAIL=hello@neelvara.com
NEXT_PUBLIC_NEELVARA_LEGAL_EMAIL=legal@neelvara.com
NEXT_PUBLIC_NEELVARA_PRIVACY_EMAIL=privacy@neelvara.com
MYCODEX_BASIC_AUTH_USER=<internal-docs-username>
MYCODEX_BASIC_AUTH_PASSWORD=<internal-docs-password>
MYCODEX_SESSION_SECRET=<generate-with-openssl-rand-base64-32>

# MenuList primary AI credential. Rotate by replacing this value in place.
MENULIST_GEMINI_AI_KEY=<google-ai-studio-or-vertex-compatible-gemini-key>
MENULIST_GEMINI_SPEND_LIMIT_USD_10M=8
# Menu extraction uses MENULIST_GEMINI_TEXT_AI_KEY in Firebase Secret Manager only.
# Other Firebase Functions use the project-local GEMINI_AI_KEY name.
OPENAI_API_KEY=

# Payments and billing
MENULIST_RAZORPAY_KEY_SECRET=<razorpay-test-secret>
MENULIST_RAZORPAY_WEBHOOK_SECRET=<razorpay-test-webhook-secret>
NEXT_PUBLIC_MENULIST_RAZORPAY_KEY_ID=rzp_test_<id>
CRON_SECRET=<internal-cron-secret>
INTERNAL_BILLING_EMAIL=<billing-email>
# Create alert-only and Gemini API spend-cap budgets for menulist-qa before paid
# Firebase/Gemini usage. This secret only protects the optional alert webhook.
GCP_BUDGET_WEBHOOK_SECRET=<gcp-budget-webhook-secret>

# Rate limiting, cache, and public revalidation
MENULIST_UPSTASH_REDIS_REST_URL=<staging-upstash-rest-url>
MENULIST_UPSTASH_REDIS_REST_TOKEN=<staging-upstash-rest-token>
MENULIST_REVALIDATION_SECRET=<same-value-in-vercel-and-firebase-secret-manager>

# Public form bot protection.
# If TURNSTILE_SECRET_KEY is set, NEXT_PUBLIC_TURNSTILE_SITE_KEY must also be set so public forms can send captchaToken.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Cloud Tasks batch image generation
# Uses NEXT_PUBLIC_MENULIST_FIREBASE_PROJECT_ID and MENULIST_FIREBASE_PROJECT_LOCATION above.
MENULIST_BATCH_IMAGE_GENERATION_WORKER_URL=https://app.menulist.digital/api/image-generation/batch-generation
MENULIST_BATCH_IMAGE_GENERATION_QUEUE_ID=batch-image-generation
MENULIST_BATCH_IMAGE_GENERATION_WORKER_SECRET=<staging-worker-secret>

# Analytics and public media integrations
GA_CLIENT_EMAIL=<ga4-service-account-email>
GA_PRIVATE_KEY=<ga4-private-key-with-escaped-newlines>
GA_PROJECT_ID=<ga4-gcp-project-id>
NEXT_PUBLIC_GA_MEASUREMENT_ID=<staging-ga-measurement-id>
NEXT_PUBLIC_CLARITY_ID=<staging-clarity-id>
NEXT_PUBLIC_MENULIST_PLAUSIBLE_DOMAIN=menulist.digital
NEXT_PUBLIC_MENULIST_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_ANSWERLATTICE_PLAUSIBLE_DOMAIN=canonica.app
NEXT_PUBLIC_ANSWERLATTICE_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_UNSPLASH_API_CLIENTID=
NEXT_PUBLIC_PIXABAY_API_CLIENTID=
NEXT_PUBLIC_PEXELS_API_CLIENTID=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Sentry and release metadata for the shared Vercel runtime. Browser, server,
# and edge events share this DSN and carry a product tag; Firebase Functions
# use project-local SENTRY_DSN Secret Manager.
NEXT_PUBLIC_SENTRY_DSN=<staging-sentry-dsn>
SENTRY_AUTH_TOKEN=<sentry-source-map-upload-token>
SENTRY_ORG=<sentry-org-slug>
SENTRY_PROJECT=<sentry-project-slug>
SENTRY_RELEASE=
SENTRY_ENABLED_IN_EMULATOR=false

# Firebase App Check and local emulators
# Keep these false/blank in Vercel. For destructive/rule-focused local work,
# use 127.0.0.1:8080 (Firestore), :9199 (Storage), and :9099 (Auth), then return
# to false/blank only for a deliberate cloud menulist-qa integration smoke.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<staging-recaptcha-v3-site-key>
NEXT_PUBLIC_MENULIST_FIREBASE_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_USE_EMULATORS=false
FUNCTIONS_EMULATOR=false
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# Email and platform notifications
MENULIST_SMTP_HOST=smtp.gmail.com
MENULIST_SMTP_PORT=587
MENULIST_SMTP_USER=<staging-sender-email>
MENULIST_SMTP_PASS=<staging-app-password>
MENULIST_TELEGRAM_BOT_TOKEN=<staging-telegram-bot-token>
MENULIST_TELEGRAM_CHAT_ID=<staging-telegram-chat-id>
INTERNAL_NOTIFICATION_EMAIL=<ops-email>
INTERNAL_NOTIFICATION_WHATSAPP=
PLATFORM_ALERT_EMAIL_TO=<ops-email>
PLATFORM_ALERT_WHATSAPP_TO=
PLATFORM_ALERT_WHATSAPP_TEMPLATE_NAME=
PLATFORM_ALERT_WHATSAPP_TEMPLATE_LANGUAGE=en_US
PLATFORM_ALERT_WHATSAPP_SESSION_ACTIVE=false
SLACK_WEBHOOK_URL=

# Optional Next.js WhatsApp outbound paths. Populate the phone id and access
# token only for an approved phone OTP or owner-notification smoke.
MENULIST_WHATSAPP_PHONE_NUMBER_ID=
MENULIST_WHATSAPP_ACCESS_TOKEN=
MENULIST_WHATSAPP_OTP_TEMPLATE_NAME=
MENULIST_WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
MENULIST_WHATSAPP_OTP_ALLOW_TEXT_FALLBACK=false
PHONE_OTP_DEV_CODE=
PHONE_OTP_DEV_SKIP_SEND=false
PHONE_OTP_DEBUG_RESPONSE=false
# Firebase Functions keep app/verify secrets in project-local Secret Manager and
# onboarding flags in functions/.env.menulist-qa, not in the root app env.
NEXT_PUBLIC_MSG_PREVIEW_BASE_URL=https://app.menulist.digital

# MenuList owner app Answerlattice widget embed
NEXT_PUBLIC_MENULIST_ANSWERLATTICE_WIDGET_KEY=
NEXT_PUBLIC_MENULIST_ANSWERLATTICE_WIDGET_SCRIPT_SRC=https://canonica.app/widget/v1/answerlattice-widget.js

# Menu link import browser controls
MENU_LINK_IMPORT_CHROME_PATH=
MENU_LINK_IMPORT_CHROME_NO_SANDBOX=false

# Vercel Domains API - only needed when domain automation is enabled
# Vercel auto-provides VERCEL, VERCEL_ENV, VERCEL_URL, and commit metadata.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional webhook verification secrets
GITHUB_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=
