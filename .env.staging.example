SIGNALDESK_PHYSICAL_ADDRESS=
SIGNALDESK_SMARTLEAD_API_KEY=
SIGNALDESK_SMARTLEAD_WEBHOOK_SECRET=

# Static products
# MyCodex is static/no DB. Do not add Firebase, billing, Storage, or Functions env keys.
# Neelvara is static/no DB. These public values only control displayed mailto links and structured data.
NEXT_PUBLIC_NEELVARA_CONTACT_EMAIL=hello@neelvara.com
NEXT_PUBLIC_NEELVARA_LEGAL_EMAIL=legal@neelvara.com
NEXT_PUBLIC_NEELVARA_PRIVACY_EMAIL=privacy@neelvara.com
MYCODEX_BASIC_AUTH_USER=<internal-docs-username>
MYCODEX_BASIC_AUTH_PASSWORD=<internal-docs-password>
MYCODEX_SESSION_SECRET=<generate-with-openssl-rand-base64-32>

# AI keys
MENULIST_GEMINI_AI_KEY=<google-ai-studio-or-vertex-compatible-gemini-key>
MENULIST_GEMINI_AI_KEY_2=
MENULIST_GEMINI_AI_KEY_3=
MENULIST_GEMINI_AI_KEY_4=
# Current MenuList runtime compatibility aliases. GEMINI_API_KEY is legacy only.
# Mirror GEMINI_AI_KEY* into Firebase Secret Manager for functions that use them.
GEMINI_AI_KEY=<same-value-as-MENULIST_GEMINI_AI_KEY>
GEMINI_API_KEY=
GEMINI_AI_KEY_2=
GEMINI_AI_KEY_3=
GEMINI_AI_KEY_4=
OPENAI_API_KEY=

# Payments and billing
MENULIST_RAZORPAY_KEY_ID=rzp_test_<id>
MENULIST_RAZORPAY_KEY_SECRET=<razorpay-test-secret>
MENULIST_RAZORPAY_WEBHOOK_SECRET=<razorpay-test-webhook-secret>
NEXT_PUBLIC_MENULIST_RAZORPAY_KEY_ID=rzp_test_<id>
# Current MenuList runtime compatibility aliases.
RAZORPAY_KEY_ID=rzp_test_<id>
RAZORPAY_KEY_SECRET=<razorpay-test-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-test-webhook-secret>
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_<id>
CRON_SECRET=<internal-cron-secret>
INTERNAL_BILLING_EMAIL=<billing-email>
GCP_BUDGET_WEBHOOK_SECRET=<gcp-budget-webhook-secret>

# Rate limiting, cache, and public revalidation
MENULIST_UPSTASH_REDIS_REST_URL=<staging-upstash-rest-url>
MENULIST_UPSTASH_REDIS_REST_TOKEN=<staging-upstash-rest-token>
# Current MenuList runtime compatibility aliases.
UPSTASH_REDIS_REST_URL=<staging-upstash-rest-url>
UPSTASH_REDIS_REST_TOKEN=<staging-upstash-rest-token>
REVALIDATION_SECRET=<same-value-in-vercel-and-firebase-secret-manager>

# Public form bot protection.
# If TURNSTILE_SECRET_KEY is set, NEXT_PUBLIC_TURNSTILE_SITE_KEY must also be set so public forms can send captchaToken.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Cloud Tasks batch image generation
# Uses FIREBASE_PROJECT_ID and FIREBASE_PROJECT_LOCATION above to build the queue path.
BATCH_IMAGE_GENERATION_WORKER_URL=<staging-worker-url>
BATCH_IMAGE_GENERATION_QUEUE_ID=<staging-queue-id>
BATCH_IMAGE_GENERATION_WORKER_SECRET=<staging-worker-secret>

# Analytics and public media integrations
GA_CLIENT_EMAIL=<ga4-service-account-email>
GA_PRIVATE_KEY=<ga4-private-key-with-escaped-newlines>
GA_PROJECT_ID=<ga4-gcp-project-id>
NEXT_PUBLIC_GA_MEASUREMENT_ID=<staging-ga-measurement-id>
NEXT_PUBLIC_CLARITY_ID=<staging-clarity-id>
NEXT_PUBLIC_MENULIST_PLAUSIBLE_DOMAIN=menulist.online
NEXT_PUBLIC_MENULIST_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_ANSWERLATTICE_PLAUSIBLE_DOMAIN=answerlattice.menulist.online
NEXT_PUBLIC_ANSWERLATTICE_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_UNSPLASH_API_CLIENTID=
NEXT_PUBLIC_PIXABAY_API_CLIENTID=
NEXT_PUBLIC_PEXELS_API_CLIENTID=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Sentry and release metadata
SENTRY_DSN=<staging-sentry-server-dsn>
SENTRY_DEV_DSN=<staging-sentry-server-dsn>
NEXT_PUBLIC_SENTRY_DEV_DSN=<staging-sentry-browser-dsn>
NEXT_PUBLIC_SENTRY_DSN=<staging-sentry-browser-dsn>
SENTRY_AUTH_TOKEN=<sentry-source-map-upload-token>
SENTRY_ORG=<sentry-org-slug>
SENTRY_PROJECT=<sentry-project-slug>
SENTRY_RELEASE=
SENTRY_ENABLED_IN_EMULATOR=false

# Firebase App Check and local emulators
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<staging-recaptcha-v3-site-key>
NEXT_PUBLIC_MENULIST_FIREBASE_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_USE_EMULATORS=false
FUNCTIONS_EMULATOR=false
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# Email and platform notifications
MENULIST_SMTP_HOST=smtp.gmail.com
MENULIST_SMTP_PORT=587
MENULIST_SMTP_USER=<staging-sender-email>
MENULIST_SMTP_PASS=<staging-app-password>
MENULIST_TELEGRAM_BOT_TOKEN=<staging-telegram-bot-token>
MENULIST_TELEGRAM_CHAT_ID=<staging-telegram-chat-id>
# Current MenuList runtime compatibility aliases.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<staging-sender-email>
SMTP_PASS=<staging-app-password>
INTERNAL_NOTIFICATION_EMAIL=<ops-email>
INTERNAL_NOTIFICATION_WHATSAPP=
