rules_version = '2';

/**
 * Firebase Storage Security Rules
 * 
 * CRITICAL: These rules enforce:
 * 1. Authentication (only logged-in users)
 * 2. Tenant isolation (users can only access their tenant's data)
 * 3. File type validation (path-specific MIME whitelists)
 * 4. File size limits (max 10MB)
 * 5. Content type validation (MIME type checking)
 * 
 * Documentation: /Users/danny/Projects/MenuListAi/dashboard/__docs__/security/
 */

service firebase.storage {
  match /b/{bucket}/o {
    
    // ═══════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════
    
    /**
     * Check if user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /**
     * Check if user belongs to the tenant
     */
    function belongsToTenant(tId) {
      return isAuthenticated() 
             && string(request.auth.token.tenantId) == string(tId);
    }
    
    /**
     * Check if user belongs to the store
     */
    function belongsToStore(tId, sId) {
      return belongsToTenant(tId)
             && (
               string(request.auth.token.storeId) == string(sId)
               || (
                 request.auth.token.storeIds != null
                 && request.auth.token.storeIds.hasAny([string(sId)])
               )
             );
    }

    function isPlatformAdmin() {
      return isAuthenticated()
             && request.auth.token.get('platformRole', null) == 'PLATFORM';
    }

    function isPlatformSupport() {
      return isAuthenticated()
             && request.auth.token.get('platformRole', null) == 'PLATFORM_SUPPORT';
    }

    function hasAnswerlatticeKnowledgeManagementPermission() {
      return isPlatformAdmin()
             || request.auth.token.get('canManageKnowledge', false) == true
             || request.auth.token.get('role', null) == 'OWNER'
             || request.auth.token.get('role', null) == 'owner'
             || request.auth.token.get('role', null) == 'MANAGER'
             || request.auth.token.get('role', null) == 'manager';
    }

    function hasAnswerlatticeSupportManagementPermission() {
      return isPlatformAdmin()
             || isPlatformSupport()
             || request.auth.token.get('canManageSupport', false) == true
             || request.auth.token.get('canManageWidget', false) == true
             || request.auth.token.get('role', null) == 'OWNER'
             || request.auth.token.get('role', null) == 'owner'
             || request.auth.token.get('role', null) == 'MANAGER'
             || request.auth.token.get('role', null) == 'manager'
             || request.auth.token.get('role', null) == 'STAFF'
             || request.auth.token.get('role', null) == 'staff';
    }

    function canAccessAnswerlatticeSupportMedia(tId, sId) {
      return isPlatformAdmin()
             || isPlatformSupport()
             || (belongsToStore(tId, sId) && hasAnswerlatticeSupportManagementPermission());
    }

    function hasValidAnswerlatticeKnowledgeSourceMetadata() {
      return request.resource.metadata.get('retentionPolicy', null) == 'delete_on_job_delete'
             && request.resource.metadata.get('sourceUse', null) == 'knowledge_generation_only'
             && request.resource.metadata.get('uploadedVia', null) == 'answerlattice_kb_generation';
    }
    
    /**
     * Validate image file type (MIME type whitelist)
     */
    function isValidImageType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isValidStaticImageType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isValidSvgType() {
      return request.resource.contentType == 'image/svg+xml';
    }

    function isValidDocumentType() {
      return request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)')
             || request.resource.contentType.matches('application/(json|xml)')
             || request.resource.contentType.matches('text/(plain|markdown|csv|html|xml)');
    }

    function isValidKnowledgeSourceType() {
      return isValidImageType()
             || isValidDocumentType()
             || request.resource.contentType.matches('audio/.*')
             || request.resource.contentType.matches('video/.*');
    }
    
    /**
     * Validate file size (max 10MB)
     */
    function isValidSize() {
      return request.resource.size <= 10 * 1024 * 1024; // 10MB
    }
    
    /**
     * Combined validation for uploads
     */
    function isValidImageUpload() {
      return isValidImageType() && isValidSize();
    }

    function isValidStaticImageUpload() {
      return isValidStaticImageType() && isValidSize();
    }

    function isValidImageOrDocumentUpload() {
      return (isValidImageType() || isValidDocumentType()) && isValidSize();
    }

    function isValidProjectUpload(fileType) {
      return (
               fileType == 'files'
               && (
                 (isValidImageType() && request.resource.size <= 10 * 1024 * 1024)
                 || (
                   request.resource.contentType == 'application/pdf'
                   && request.resource.size <= 50 * 1024 * 1024
                 )
               )
             )
             || (
               fileType.matches('^(assets|itemImages|project-images|custom|generated|edited)$')
               && isValidImageType()
               && request.resource.size <= 10 * 1024 * 1024
             );
    }

    function isValidPlatformAssetUpload() {
      return (isValidImageType() || isValidSvgType() || isValidDocumentType()) && isValidSize();
    }

    function canAccessCreativeEditorTemplateStore(tId, sId) {
      return belongsToStore(tId, sId);
    }

    function isValidCreativeEditorTemplateUpload(fileName) {
      return request.resource.size <= 750 * 1024
             && (
               (
                 (
                   fileName == 'document.json'
                   || fileName.matches('^document-[a-zA-Z0-9_-]{8,64}\\.json$')
                 )
                 && request.resource.contentType == 'application/json'
               )
               || (
                 (
                   fileName.matches('^preview\\.(png|jpg|jpeg|webp)$')
                   || fileName.matches('^preview-[a-zA-Z0-9_-]{8,64}\\.(png|jpg|jpeg|webp)$')
                 )
                 && isValidImageType()
               )
             );
    }

    function isValidMediaProfile(profile) {
      return profile.matches('^(menuItem|projectImage|menuBackground|businessLogo|businessCover|digitalScreenSlide|galleryImage)$');
    }
    
    // ═══════════════════════════════════════════════════════════
    // TENANT-SCOPED STORAGE PATTERN (NEW)
    // Path: {collection}/{fileType}/{tId}/{sId}/{fileId}
    // ═══════════════════════════════════════════════════════════
    
    /**
     * Chat Session Images
     * Path: chatSessions/chatimages/{tId}/{sId}/{imageId}
     */
    match /chatSessions/chatimages/{tId}/{sId}/{imageId} {
      allow read: if canAccessAnswerlatticeSupportMedia(tId, sId);
      allow write: if canAccessAnswerlatticeSupportMedia(tId, sId)
                   && isValidImageType()
                   && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if canAccessAnswerlatticeSupportMedia(tId, sId);
    }
    
    /**
     * Support Ticket Documents
     * Path: supportTickets/documents/{tId}/{sId}/{fileId}
     */
    match /supportTickets/documents/{tId}/{sId}/{fileId} {
      allow read: if canAccessAnswerlatticeSupportMedia(tId, sId);
      allow write: if canAccessAnswerlatticeSupportMedia(tId, sId) && isValidImageOrDocumentUpload();
      allow delete: if canAccessAnswerlatticeSupportMedia(tId, sId);
    }
    
    /**
     * Support Ticket Message Attachments
     * Path: supportTickets/messages/{tId}/{sId}/{fileId}
     */
    match /supportTickets/messages/{tId}/{sId}/{fileId} {
      allow read: if canAccessAnswerlatticeSupportMedia(tId, sId);
      allow write: if canAccessAnswerlatticeSupportMedia(tId, sId) && isValidImageOrDocumentUpload();
      allow delete: if canAccessAnswerlatticeSupportMedia(tId, sId);
    }
    
    /**
     * Changelog Files
     * Path: changelog/files/{tId}/{sId}/{fileId}
     */
    match /changelog/files/{tId}/{sId}/{fileId} {
      allow read: if belongsToStore(tId, sId);
      allow write: if belongsToStore(tId, sId)
                   && hasAnswerlatticeKnowledgeManagementPermission()
                   && isValidImageOrDocumentUpload();
      allow delete: if belongsToStore(tId, sId) && hasAnswerlatticeKnowledgeManagementPermission();
    }

    /**
     * Prepared Media Images
     * Path: media/{profile}/{tId}/{sId}/{entityId}/{fileId}
     */
    match /media/{profile}/{tId}/{sId}/{entityId}/{fileId} {
      allow read: if true;
      allow write: if resource == null
                   && belongsToStore(tId, sId)
                   && isValidStaticImageUpload()
                   && isValidMediaProfile(profile);
      allow delete: if belongsToStore(tId, sId);
    }

    /**
     * Store-owned direct uploads that have not yet migrated to media profiles.
     * Path: stores/{fileType}/{tId}/{sId}/{fileId}
     */
    match /stores/{fileType}/{tId}/{sId}/{fileId} {
      allow read: if true;
      allow write: if belongsToStore(tId, sId)
                   && fileType.matches('^(pwa-icons|obp-photos|obp-covers)$')
                   && isValidImageUpload();
      allow delete: if belongsToStore(tId, sId);
    }

    /**
     * Notes documents, tenant-scoped.
     * Path: notes/documents/{tId}/{sId}/{noteId}/{fileId}
     */
    match /notes/documents/{tId}/{sId}/{noteId}/{fileId} {
      allow read: if belongsToStore(tId, sId);
      allow write: if belongsToStore(tId, sId) && isValidImageOrDocumentUpload();
      allow delete: if belongsToStore(tId, sId);
    }

    /**
     * Project upload fallback paths for menu files and images.
     * Path: projects/{fileType}/{tId}/{sId}/{fileId}
     */
    match /projects/{fileType}/{tId}/{sId}/{fileId} {
      allow read: if belongsToStore(tId, sId);
      allow write: if belongsToStore(tId, sId)
                   && fileType.matches('^(files|assets|itemImages|project-images|custom|generated|edited)$')
                   && isValidProjectUpload(fileType);
      allow delete: if belongsToStore(tId, sId);
    }

    /**
     * Knowledge-base ingestion source files.
     * Path: ingestion_source_files/{tId}/{sId}/{fileId}
     */
    match /ingestion_source_files/{tId}/{sId}/{fileId} {
      allow read: if isPlatformAdmin() || belongsToStore(tId, sId);
      allow write: if (isPlatformAdmin() || (belongsToStore(tId, sId) && hasAnswerlatticeKnowledgeManagementPermission()))
                   && isValidKnowledgeSourceType()
                   && request.resource.size <= 10 * 1024 * 1024
                   && hasValidAnswerlatticeKnowledgeSourceMetadata();
      allow delete: if isPlatformAdmin() || (belongsToStore(tId, sId) && hasAnswerlatticeKnowledgeManagementPermission());
    }

    /**
     * Platform-managed assets and fonts.
     */
    match /common/assets/{assetType}/{fileId} {
      allow read: if true;
      allow write: if isPlatformAdmin() && isValidPlatformAssetUpload();
      allow delete: if isPlatformAdmin();
    }

    match /fonts/{fileName} {
      allow read: if true;
      allow write: if isPlatformAdmin()
        && request.resource.contentType.matches('font/.*|application/(font-woff|font-woff2|octet-stream)')
        && isValidSize();
      allow delete: if isPlatformAdmin();
    }

    match /templates/{componentId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin() && isValidPlatformAssetUpload();
      allow delete: if isPlatformAdmin();
    }

    /**
     * Creative Editor Template Registry
     * Platform: creative-editor/templates/platform/{businessCategory}/{templateId}/{fileName}
     * User/store: creative-editor/templates/user/{tId}/{sId}/{templateId}/{fileName}
     */
    match /creative-editor/templates/platform/{businessCategory}/{templateId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin() && isValidCreativeEditorTemplateUpload(fileName);
      allow delete: if isPlatformAdmin();
    }

    match /creative-editor/templates/user/{tId}/{sId}/{templateId}/{fileName} {
      allow read: if canAccessCreativeEditorTemplateStore(tId, sId);
      allow write: if canAccessCreativeEditorTemplateStore(tId, sId)
                   && isValidCreativeEditorTemplateUpload(fileName);
      allow delete: if canAccessCreativeEditorTemplateStore(tId, sId);
    }

    match /tenants/logos/{fileId} {
      allow read: if true;
      allow write: if isPlatformAdmin() && isValidImageUpload();
      allow delete: if isPlatformAdmin();
    }

    match /blogs/profileImages/{fileId} {
      allow read: if true;
      allow write: if isPlatformAdmin() && isValidImageUpload();
      allow delete: if isPlatformAdmin();
    }

    match /users/{fileType}/{fileId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && fileId.matches('^' + request.auth.uid + '[-_].*')
        && fileType.matches('^(profile|additionalDocuments)$')
        && isValidImageOrDocumentUpload();
      allow delete: if isAuthenticated()
        && fileId.matches('^' + request.auth.uid + '[-_].*')
        && fileType.matches('^(profile|additionalDocuments)$');
    }
    
    // ═══════════════════════════════════════════════════════════
    // LEGACY PROJECT STORAGE PATTERN (READ-ONLY CUTOVER)
    // Path: MenuListAi/project/{type}/{fileId}
    // Active uploads now use tenant-scoped projects/{fileType}/{tId}/{sId}/{fileId}.
    // Keep authenticated reads for existing objects, but block new writes/deletes.
    // ═══════════════════════════════════════════════════════════
    
    /**
     * Project Files (Legacy Pattern)
     * Path: MenuListAi/project/files/{fileId}
     */
    match /MenuListAi/project/files/{fileId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
    
    /**
     * Project Generated Images (Legacy Pattern)
     * Path: MenuListAi/project/generated/{projectId}/{fileId}
     */
    match /MenuListAi/project/generated/{projectId}/{fileId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
    
    /**
     * Project Edited Images (Legacy Pattern)
     * Path: MenuListAi/project/edited/{projectId}/{fileId}
     */
    match /MenuListAi/project/edited/{projectId}/{fileId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
    
    /**
     * Project Custom Images (Legacy Pattern)
     * Path: MenuListAi/project/custom/{projectId}/{fileId}
     */
    match /MenuListAi/project/custom/{projectId}/{fileId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
    
    /**
     * Customer App (PWA) — Icon Overrides
     *
     * Generated icons remain route-backed. Owner overrides use the scoped
     * `stores/pwa-icons/{tId}/{sId}/{fileId}` rule above with unique immutable
     * object names. Legacy project paths remain read-only.
     *
     * @see __docs__/customer-app/customer-app_firebase.md §Storage
     */

    // ═══════════════════════════════════════════════════════════
    // DEFAULT DENY (Security First)
    // ═══════════════════════════════════════════════════════════
    
    /**
     * Deny all other access by default
     * Explicit allow rules must be defined above
     */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
