rules_version = '2';

/**
 * Answerlattice Firebase Storage rules.
 *
 * Scope: Answerlattice QA/prod storage buckets only. Keep MenuList owner/public
 * storage paths out of this file so product storage policy remains clear.
 */

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated()
             && request.auth.token.get('platformRole', null) == 'PLATFORM';
    }

    function isPlatformSupport() {
      return isAuthenticated()
             && request.auth.token.get('platformRole', null) == 'PLATFORM_SUPPORT';
    }

    function belongsToTenant(tId) {
      return isAuthenticated()
             && string(request.auth.token.get('tenantId', null)) == string(tId);
    }

    function belongsToStore(tId, sId) {
      return belongsToTenant(tId)
             && (
               string(request.auth.token.get('storeId', null)) == string(sId)
               || (
                 request.auth.token.get('storeIds', []) is list
                 && request.auth.token.get('storeIds', []).hasAny([string(sId)])
               )
             );
    }

    function isActiveAnswerlatticeWorkspace(tId, sId) {
      let store = firestore.get(/databases/(default)/documents/stores/$(sId));
      return store.data.pId == 'AL'
             && string(store.data.tId) == string(tId)
             && string(store.data.sId) == string(sId)
             && store.data.get('active', false) == true
             && store.data.get('deleted', false) != true
             && store.data.get('authDisabled', false) != true;
    }

    function hasKnowledgeManagementPermission() {
      return isPlatformAdmin()
             || request.auth.token.get('canManageKnowledge', false) == true
             || request.auth.token.get('role', null) == 'OWNER'
             || request.auth.token.get('role', null) == 'owner'
             || request.auth.token.get('role', null) == 'MANAGER'
             || request.auth.token.get('role', null) == 'manager';
    }

    function hasSupportManagementPermission() {
      return isPlatformAdmin()
             || isPlatformSupport()
             || request.auth.token.get('canManageSupport', false) == true
             || request.auth.token.get('canManageWidget', false) == true
             || request.auth.token.get('role', null) == 'OWNER'
             || request.auth.token.get('role', null) == 'owner'
             || request.auth.token.get('role', null) == 'MANAGER'
             || request.auth.token.get('role', null) == 'manager'
             || request.auth.token.get('role', null) == 'STAFF'
             || request.auth.token.get('role', null) == 'staff';
    }

    function canAccessSupportMedia(tId, sId) {
      return isActiveAnswerlatticeWorkspace(tId, sId)
             && (
               isPlatformAdmin()
               || isPlatformSupport()
               || (belongsToStore(tId, sId) && hasSupportManagementPermission())
             );
    }

    function hasValidKnowledgeSourceMetadata() {
      return request.resource.metadata.get('retentionPolicy', null) == 'delete_on_job_delete'
             && request.resource.metadata.get('sourceUse', null) == 'knowledge_generation_only'
             && request.resource.metadata.get('uploadedVia', null) == 'answerlattice_kb_generation';
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isValidDocumentType() {
      return request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)')
             || request.resource.contentType.matches('application/(json|xml)')
             || request.resource.contentType.matches('text/(plain|markdown|csv|html|xml)');
    }

    function isValidKnowledgeSourceType() {
      return isValidImageType()
             || isValidDocumentType()
             || request.resource.contentType.matches('audio/.*')
             || request.resource.contentType.matches('video/.*');
    }

    function isValidImageUpload() {
      return isValidImageType() && request.resource.size <= 5 * 1024 * 1024;
    }

    function isValidImageOrDocumentUpload() {
      return (isValidImageType() || isValidDocumentType())
             && request.resource.size <= 10 * 1024 * 1024;
    }

    match /chatSessions/chatimages/{tId}/{sId}/{imageId} {
      allow read: if canAccessSupportMedia(tId, sId);
      allow write: if canAccessSupportMedia(tId, sId) && isValidImageUpload();
      allow delete: if canAccessSupportMedia(tId, sId);
    }

    match /supportTickets/documents/{tId}/{sId}/{fileId} {
      allow read: if canAccessSupportMedia(tId, sId);
      allow write: if canAccessSupportMedia(tId, sId) && isValidImageOrDocumentUpload();
      allow delete: if canAccessSupportMedia(tId, sId);
    }

    match /supportTickets/messages/{tId}/{sId}/{fileId} {
      allow read: if canAccessSupportMedia(tId, sId);
      allow write: if canAccessSupportMedia(tId, sId) && isValidImageOrDocumentUpload();
      allow delete: if canAccessSupportMedia(tId, sId);
    }

    match /changelog/files/{tId}/{sId}/{fileId} {
      allow read: if isActiveAnswerlatticeWorkspace(tId, sId)
                  && belongsToStore(tId, sId);
      allow write: if isActiveAnswerlatticeWorkspace(tId, sId)
                   && belongsToStore(tId, sId)
                   && hasKnowledgeManagementPermission()
                   && isValidImageOrDocumentUpload();
      allow delete: if isActiveAnswerlatticeWorkspace(tId, sId)
                    && belongsToStore(tId, sId)
                    && hasKnowledgeManagementPermission();
    }

    match /ingestion_source_files/{tId}/{sId}/{fileId} {
      allow read: if isActiveAnswerlatticeWorkspace(tId, sId)
                  && (isPlatformAdmin() || belongsToStore(tId, sId));
      allow write: if isActiveAnswerlatticeWorkspace(tId, sId)
                   && (isPlatformAdmin() || (belongsToStore(tId, sId) && hasKnowledgeManagementPermission()))
                   && isValidKnowledgeSourceType()
                   && request.resource.size <= 10 * 1024 * 1024
                   && hasValidKnowledgeSourceMetadata();
      allow delete: if isActiveAnswerlatticeWorkspace(tId, sId)
                    && (isPlatformAdmin() || (belongsToStore(tId, sId) && hasKnowledgeManagementPermission()));
    }

    match /answerlattice-context/public/{publicBundleId}/{version}/{filePath=**} {
      // Public-safe payloads remain server-mediated so the proxy can enforce
      // rate, size, observability, and workspace-lifecycle revocation controls.
      allow read, write, delete: if false;
    }

    match /answerlattice-context/private/{tId}/{sId}/{version}/{filePath=**} {
      allow read, write, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
