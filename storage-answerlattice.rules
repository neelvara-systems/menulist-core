rules_version = '2';

/**
 * Answerlattice Firebase Storage rules.
 *
 * Scope: Answerlattice QA/prod storage buckets only. Keep MenuList owner/public
 * storage paths out of this file so product storage policy remains clear.
 */

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated()
             && request.auth.token.platformRole == 'PLATFORM';
    }

    function belongsToTenant(tId) {
      return isAuthenticated()
             && string(request.auth.token.tenantId) == string(tId);
    }

    function belongsToStore(tId, sId) {
      return belongsToTenant(tId)
             && (
               string(request.auth.token.storeId) == string(sId)
               || (
                 request.auth.token.storeIds != null
                 && request.auth.token.storeIds.hasAny([string(sId)])
               )
             );
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isValidDocumentType() {
      return request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)')
             || request.resource.contentType == 'text/plain';
    }

    function isValidKnowledgeSourceType() {
      return isValidImageType()
             || isValidDocumentType()
             || request.resource.contentType.matches('audio/.*')
             || request.resource.contentType.matches('video/.*');
    }

    function isValidImageUpload() {
      return isValidImageType() && request.resource.size <= 5 * 1024 * 1024;
    }

    function isValidImageOrDocumentUpload() {
      return (isValidImageType() || isValidDocumentType())
             && request.resource.size <= 10 * 1024 * 1024;
    }

    match /chatSessions/chatimages/{tId}/{sId}/{imageId} {
      allow read: if belongsToStore(tId, sId);
      allow write: if belongsToStore(tId, sId) && isValidImageUpload();
      allow delete: if belongsToStore(tId, sId);
    }

    match /supportTickets/documents/{tId}/{sId}/{fileId} {
      allow read: if belongsToStore(tId, sId);
      allow write: if belongsToStore(tId, sId) && isValidImageOrDocumentUpload();
      allow delete: if belongsToStore(tId, sId);
    }

    match /supportTickets/messages/{tId}/{sId}/{fileId} {
      allow read: if belongsToStore(tId, sId);
      allow write: if belongsToStore(tId, sId) && isValidImageOrDocumentUpload();
      allow delete: if belongsToStore(tId, sId);
    }

    match /changelog/files/{tId}/{sId}/{fileId} {
      allow read: if belongsToStore(tId, sId);
      allow write: if belongsToStore(tId, sId) && isValidImageOrDocumentUpload();
      allow delete: if belongsToStore(tId, sId);
    }

    match /ingestion_source_files/{tId}/{sId}/{fileId} {
      allow read: if isPlatformAdmin() || belongsToStore(tId, sId);
      allow write: if (isPlatformAdmin() || belongsToStore(tId, sId))
                   && isValidKnowledgeSourceType()
                   && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isPlatformAdmin() || belongsToStore(tId, sId);
    }

    match /answerlattice-context/public/{publicBundleId}/{version}/{filePath=**} {
      allow read: if publicBundleId.matches('^pb_[A-Za-z0-9_-]{8,80}$')
                  && version.matches('^v[0-9]+$');
      allow write, delete: if false;
    }

    match /answerlattice-context/private/{tId}/{sId}/{version}/{filePath=**} {
      allow read, write, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
