{
  "name": "answerlattice-functions",
  "description": "Answerlattice Cloud Functions — Governed Answer Infrastructure",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions --config ../firebase-answerlattice.json",
    "shell": "npm run build && firebase functions:shell --config ../firebase-answerlattice.json",
    "deploy": "npm run deploy:prod",
    "deploy:qa": "firebase deploy --only functions:answerlattice --project neelvara-answerlattice-qa --config ../firebase-answerlattice.json",
    "deploy:prod": "firebase deploy --only functions:answerlattice --project neelvara-answerlattice-prod --config ../firebase-answerlattice.json",
    "logs": "npm run logs:prod",
    "logs:qa": "firebase functions:log --project neelvara-answerlattice-qa --config ../firebase-answerlattice.json",
    "logs:prod": "firebase functions:log --project neelvara-answerlattice-prod --config ../firebase-answerlattice.json"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "2.13.0",
    "@react-email/render": "2.1.0",
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.3.0",
    "nodemailer": "9.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.20.0"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "private": true
}
