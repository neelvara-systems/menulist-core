# Answerlattice Functions dotenv template for answerlattice production.
# Copy to functions-answerlattice/.env.answerlattice only if a deployed
# function needs non-secret env values. Store ANSWERLATTICE_CRON_SECRET and
# ANSWERLATTICE_GEMINI_AI_KEY* with Firebase Secret Manager, not in this file.

ANSWERLATTICE_FIREBASE_MODE=separate
ANSWERLATTICE_FIREBASE_PROJECT_ID=answerlattice
ANSWERLATTICE_FIREBASE_STORAGE_BUCKET=<answerlattice-storage-bucket>
ANSWERLATTICE_FIRESTORE_DATABASE_ID=
ANSWERLATTICE_GEMINI_SPEND_LIMIT_USD_10M=8
