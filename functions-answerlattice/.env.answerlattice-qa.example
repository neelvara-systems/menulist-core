# Answerlattice Functions dotenv template for answerlattice-qa.
# Copy to functions-answerlattice/.env.answerlattice-qa only if a deployed
# function needs non-secret env values. Store ANSWERLATTICE_CRON_SECRET with
# Firebase Secret Manager, not in this file.

ANSWERLATTICE_FIREBASE_MODE=separate
ANSWERLATTICE_FIREBASE_PROJECT_ID=answerlattice-qa
ANSWERLATTICE_FIREBASE_STORAGE_BUCKET=<answerlattice-qa-storage-bucket>
ANSWERLATTICE_FIRESTORE_DATABASE_ID=

