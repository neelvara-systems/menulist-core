{
  "name": "canonica-functions",
  "description": "Canonica Cloud Functions — Support Knowledge Control Plane",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions --config ../firebase-canonica.json",
    "shell": "npm run build && firebase functions:shell --config ../firebase-canonica.json",
    "deploy": "npm run deploy:prod",
    "deploy:qa": "firebase deploy --only functions:canonica --project canonica-qa --config ../firebase-canonica.json",
    "deploy:prod": "firebase deploy --only functions:canonica --project canonica --config ../firebase-canonica.json",
    "logs": "npm run logs:prod",
    "logs:qa": "firebase functions:log --project canonica-qa --config ../firebase-canonica.json",
    "logs:prod": "firebase functions:log --project canonica --config ../firebase-canonica.json"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/vertexai": "^1.0.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "nodemailer": "^8.0.2"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.11",
    "firebase-functions-test": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
