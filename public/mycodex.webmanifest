{
  "name": "MyCodex",
  "short_name": "MyCodex",
  "description": "Private documentation reader for MenuList and Canonica operating knowledge.",
  "theme_color": "#09090b",
  "background_color": "#09090b",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
