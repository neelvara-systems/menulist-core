    function answerlatticeBundleManifestClientKeys() {
      return [
        'schemaVersion',
        'pId',
        'tId',
        'sId',
        'status',
        'staleReason',
        'updatedAt',
        'lastReason',
        'lastSourceId',
        'lastSourceType'
      ];
