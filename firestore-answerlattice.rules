rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny. Answerlattice client access is explicitly tenant-scoped below.
    match /{document=**} {
      allow read, write: if false;
    }

    match /platformSummary/{document} {
      allow read: if isAuthenticated()
                  && (isPlatformAdmin()
                      || (
                        isAnswerlatticePlatformSummaryClientReadableDoc(document)
                        && isAnswerlatticeTenantMember(resource.data)
                        && hasAnswerlatticePlatformSummaryReadPermission(document)
                      ));
      allow create: if isAuthenticated()
                    && isAnswerlatticePlatformSummaryDoc(document)
                    && !document.matches('^knowledgeIntakeSummary_.*$')
                    && !document.matches('^ontologyCounters_.*$')
                    && (isPlatformAdmin() || (hasAnswerlatticePlatformSummaryWritePermission(document) && canCreateAnswerlatticePlatformSummaryDoc(document)));
      allow update: if isAuthenticated()
                    && isAnswerlatticePlatformSummaryDoc(document)
                    && !document.matches('^knowledgeIntakeSummary_.*$')
                    && !document.matches('^ontologyCounters_.*$')
                    && (isPlatformAdmin() || (hasAnswerlatticePlatformSummaryWritePermission(document) && canUpdateAnswerlatticePlatformSummaryDoc(document)));
      allow delete: if false;
    }

    match /answerlattice_entities/{docId} {
      allow read: if isAnswerlatticeScopedReadWithKnowledgeControl();
      allow write: if false;
    }

    match /answerlattice_entitySlugIndex/{docId} {
      allow read, write: if false;
    }

    match /answerlattice_entityRelations/{docId} {
      allow read: if isAnswerlatticeScopedReadWithKnowledgeControl();
      allow write: if false;
    }

    match /answerlattice_canonicalAnswers/{docId} {
      allow read: if isAnswerlatticeScopedReadWithKnowledgeControl();
      // Canonical truth is written only by the server-owned governance
      // transaction. Browser clients may read, but cannot publish or edit it.
      allow create, update: if false;
      allow delete: if false;
    }

    match /answerlattice_releases/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageKnowledge');
      // Release ordering, drift evaluation, and activation are one server-owned
      // transaction through /api/answerlattice/releases.
      allow create, update: if false;
      allow delete: if false;
    }

    match /answerlattice_changelogEntryIndex/{docId} {
      allow read, write: if false;
    }

    match /answerlattice_mutationProposals/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageGovernance');
      allow create: if isAnswerlatticeScopedCreateWithPermission('canManageGovernance')
        && isValidAnswerlatticePendingMutationProposal(request.resource.data);
      // Review decisions and implementation state are server-authoritative.
      allow update: if false;
      allow delete: if false;
    }

    match /answerlattice_signalEvents/{docId} {
      allow read: if isAnswerlatticeScopedReadWithSupportControl();
      allow create: if isValidAnswerlatticeSignalCreate(request.resource.data)
        && (
          isAnswerlatticeScopedCreateWithSupportControl()
          || isAnswerlatticeFeedbackSignalCreate()
        );
      allow update, delete: if false;
    }

    match /answerlattice_auditLogs/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageGovernance');
      allow create: if isAnswerlatticeScopedCreateWithPermission('canManageGovernance')
        && !isAnswerlatticeServerReservedAuditAction(request.resource.data);
      allow update, delete: if false;
    }

    match /answerlattice_entitySearchIndex/{docId} {
      allow read: if isAnswerlatticeScopedReadWithKnowledgeControl();
      allow write: if false;
    }

    match /answerlattice_entityCandidates/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageGovernance');
      allow write: if false;
    }

    match /answerlattice_frictionDailyStats/{docId} {
      allow read: if isAnswerlatticeScopedReadWithReadiness();
      allow write: if false;
    }

    match /answerlattice_schedulerRunLogs/{docId} {
      allow read: if isAuthenticated() && isPlatformAdmin();
      allow write: if false;
    }

    match /answerlattice_aiOperations/{tId}/{sId}/{docId} {
      allow read: if isAuthenticated()
        && isPlatformAdmin();
      allow write: if false;
    }

    match /answerlattice_integrationEvents/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageIntegrations');
      allow write: if false;
    }

    match /answerlattice_integrationDeliveryLogs/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageIntegrations');
      allow write: if false;
    }

    match /answerlattice_predictiveTriggers/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageGovernance');
      allow create: if isAnswerlatticeScopedCreateWithPermission('canManageGovernance');
      allow update: if isAnswerlatticeScopedUpdateWithPermission('canManageGovernance');
      allow delete: if isAnswerlatticeScopedDeleteWithPermission('canManageGovernance');
    }

    match /answerlattice_productSurfaces/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageKnowledge');
      allow create: if isAnswerlatticeScopedCreateWithPermission('canManageKnowledge');
      allow update: if isAnswerlatticeScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if false;
    }

    match /answerlattice_faqs/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageKnowledge');
      allow create: if isAnswerlatticeScopedCreateWithPermission('canManageKnowledge');
      allow update: if isAnswerlatticeScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if false;
    }

    match /answerlattice_supportBoardCards/{docId} {
      allow read: if isAnswerlatticeScopedReadWithSupportControl();
      allow create: if isAnswerlatticeScopedCreateWithSupportControl()
        && isValidAnswerlatticeSupportBoardCard(request.resource.data);
      allow update: if isAnswerlatticeScopedUpdateWithSupportControl()
        && isValidAnswerlatticeSupportBoardCard(request.resource.data)
        && request.resource.data.sourceType == resource.data.sourceType
        && request.resource.data.sourceId == resource.data.sourceId;
      allow delete: if false;
    }

    match /answerlattice_knowledgeIntakeJobs/{docId} {
      allow read: if isAnswerlatticeScopedReadWithKnowledgeControl();
      // Intake lifecycle, counters, and paid processing are server-owned.
      allow write: if false;
    }

    match /answerlattice_knowledgeSources/{docId} {
      allow read: if isAnswerlatticeScopedReadWithKnowledgeControl();
      allow write: if false;
    }

    match /answerlattice_intakeReviewItems/{docId} {
      allow read: if isAnswerlatticeScopedReadWithKnowledgeControl();
      allow write: if false;
    }

    match /answerlattice_intakeUsageLedger/{docId} {
      allow read: if isAnswerlatticeScopedReadWithKnowledgeControl();
      allow write: if false;
    }

    match /answerlattice_cacheVersions/{docId} {
      allow read: if isAnswerlatticeScopedReadWithKnowledgeControl()
        || isAnswerlatticeScopedReadWithPermission('canManageWidget');
      allow create: if isAnswerlatticeScopedCreateWithKnowledgeControl()
        || isAnswerlatticeScopedCreateWithPermission('canManageWidget');
      allow update: if isAnswerlatticeScopedUpdateWithKnowledgeControl()
        || isAnswerlatticeScopedUpdateWithPermission('canManageWidget');
      allow delete: if false;
    }

    match /answerlattice_notificationLogs/{docId} {
      allow read: if isAuthenticated() && isPlatformAdmin();
      allow write: if false;
    }

    match /chatSessions/{docId} {
      allow read: if isAnswerlatticeScopedReadWithSupportControl();
      allow create: if isAnswerlatticeScopedCreateWithSupportControl()
        && isValidAnswerlatticeChatActor(request.resource.data)
        && isValidAnswerlatticeChatSessionDocument(request.resource.data);
      allow update: if isAnswerlatticeScopedUpdateWithSupportControl()
        && isValidAnswerlatticeChatSessionUpdate(resource.data, request.resource.data);
      allow delete: if isAnswerlatticeScopedDeleteWithSupportControl();
    }

    match /chatAnalytics/{docId} {
      allow read: if isAnswerlatticeScopedReadWithSupportControl()
        && resource.data.pId == 'AL';
      allow write: if false;
    }

    match /insights/{tId}/stores/{sId}/ai/{docId} {
      allow read: if isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            isAnswerlatticeTenantPath(tId, sId)
            && hasAnswerlatticeReadinessPermission()
          )
        )
        && resource.data.pId == 'AL'
        && string(resource.data.tId) == string(tId)
        && string(resource.data.sId) == string(sId);
      allow write: if false;
    }

    match /feedback/{docId} {
      allow read: if isAnswerlatticeScopedReadWithSupportControl()
        || isAnswerlatticeFeedbackSelfRead();
      allow create: if isValidAnswerlatticeFeedbackPayload(request.resource.data)
        && (
          isAnswerlatticeScopedCreateWithSupportControl()
          || isAnswerlatticeFeedbackSelfCreate()
        );
      allow update: if isAnswerlatticeScopedUpdateWithSupportControl()
        && isValidAnswerlatticeFeedbackSurfaceUpdate();
      allow delete: if false;
    }

    match /supportTickets/{docId} {
      allow read: if isAnswerlatticeScopedReadWithSupportControl();
      allow create: if isAnswerlatticeScopedCreateWithSupportControl()
        && isValidAnswerlatticeSupportTicketCreate(request.resource.data);
      allow update: if isAnswerlatticeScopedUpdateWithSupportControl()
        && isValidAnswerlatticeSupportTicketUpdate(resource.data, request.resource.data);
      allow delete: if isAuthenticated() && isPlatformAdmin() && resource.data.pId == 'AL';
    }

    match /stores/{storeId} {
      allow read: if isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            string(storeId) == string(request.auth.token.storeId)
            && isAnswerlatticeTenantStoreMember(resource.data)
            && hasAnyAnswerlatticePermission()
          )
        );
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated()
        && (isPlatformAdmin() || (isAnswerlatticeTenantStoreMember(resource.data) && hasAnswerlatticePermission('canManageBilling')));
      allow write: if false;
    }

    match /payment_transactions/{transactionId} {
      allow read: if isAuthenticated()
        && (isPlatformAdmin() || (isAnswerlatticeTenantStoreMember(resource.data) && hasAnswerlatticePermission('canManageBilling')));
      allow write: if false;
    }

    match /queryEmbeddings/{docId} {
      allow read, write: if false;
    }

    // KB collections can live in the Answerlattice Firebase project for the
    // founder-onboarding bootstrap. They remain tenant/store-scoped.
    match /kb_categories/{docId} {
      allow read: if isAuthenticated()
        && (isPlatformAdmin() || (kbCategoriesDocMatchesCurrentStore(docId) && hasAnswerlatticePermission('canManageKnowledge')));
      allow create, update: if isAuthenticated()
        && (isPlatformAdmin() || (hasAnswerlatticePermission('canManageKnowledge') && kbCategoriesDocMatchesCurrentStore(docId)));
      allow delete: if isAuthenticated() && isPlatformAdmin();
    }

    match /kb_articles/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageKnowledge');
      allow create: if isAnswerlatticeScopedCreateWithPermission('canManageKnowledge');
      allow update: if isAnswerlatticeScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if isAnswerlatticeScopedDeleteWithPermission('canManageKnowledge');
    }

    match /kb_sections/{docId} {
      allow read: if isAnswerlatticeScopedReadWithPermission('canManageKnowledge');
      allow create: if isAnswerlatticeScopedCreateWithPermission('canManageKnowledge');
      allow update: if isAnswerlatticeScopedUpdateWithPermission('canManageKnowledge');
      allow delete: if isAnswerlatticeScopedDeleteWithPermission('canManageKnowledge');
    }

    match /kb_generation_jobs/{docId} {
      // Legacy generation jobs are maintained by the internal platform import
      // tool. Product owners use the server-owned Knowledge Intake pipeline.
      allow read, create, update, delete: if isAuthenticated() && isPlatformAdmin();
    }

    match /kb_staging_sections/{docId} {
      allow read, create, update, delete: if isAuthenticated() && isPlatformAdmin();
    }

    match /kb_staging_chunks/{docId} {
      allow read, create, update, delete: if isAuthenticated() && isPlatformAdmin();
    }

    match /aiSearchHistory/{docId} {
      allow read: if isAnswerlatticeScopedReadWithSupportControl();
      allow create: if false;
      allow update: if isAnswerlatticeScopedUpdateWithSupportControl()
        && isValidAnswerlatticeAiSearchFeedbackUpdate(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /changelog/{tId}/{sId}/{pageId} {
      allow read: if isAuthenticated()
        && (isPlatformAdmin() || isAnswerlatticeTenantPath(tId, sId));
      // Changelog page mutations and reactions are server-owned so page/index,
      // cache freshness, idempotency, and bounded feedback history stay atomic.
      allow write: if false;
    }

    match /changelog_feedback/{tId}/{sId}/{docId} {
      allow read: if isAnswerlatticeContentFeedbackRead(tId, sId);
      allow write: if false;
    }

    match /article_feedback/{tId}/{sId}/{docId} {
      allow read: if isAnswerlatticeContentFeedbackRead(tId, sId);
      allow write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return request.auth != null
        && request.auth.token.get('platformRole', null) == 'PLATFORM';
    }

    function isAnswerlatticeOwnerRole() {
      return request.auth.token.get('role', null) == 'OWNER'
        || request.auth.token.get('role', null) == 'owner';
    }

    function isAnswerlatticeManagerRole() {
      return request.auth.token.get('role', null) == 'MANAGER'
        || request.auth.token.get('role', null) == 'manager';
    }

    function isAnswerlatticeStaffRole() {
      return request.auth.token.get('role', null) == 'STAFF'
        || request.auth.token.get('role', null) == 'staff';
    }

    function defaultManagerHasAnswerlatticePermission(permission) {
      return isAnswerlatticeManagerRole()
        && (
          permission == 'canViewReadiness'
          || permission == 'canManageWorkspace'
          || permission == 'canManageTeam'
          || permission == 'canManageKnowledge'
          || permission == 'canManageGovernance'
          || permission == 'canManageWidget'
          || permission == 'canManageSupport'
        );
    }

    function defaultStaffHasAnswerlatticePermission(permission) {
      return isAnswerlatticeStaffRole() && permission == 'canManageSupport';
    }

    function hasAnswerlatticePermission(permission) {
      return isPlatformAdmin()
        || request.auth.token.get(permission, false) == true
        || isAnswerlatticeOwnerRole()
        || defaultManagerHasAnswerlatticePermission(permission)
        || defaultStaffHasAnswerlatticePermission(permission);
    }

    function hasAnyAnswerlatticePermission() {
      return hasAnswerlatticePermission('canViewReadiness')
        || hasAnswerlatticePermission('canManageWorkspace')
        || hasAnswerlatticePermission('canManageTeam')
        || hasAnswerlatticePermission('canAssignRoles')
        || hasAnswerlatticePermission('canManageBilling')
        || hasAnswerlatticePermission('canManageKnowledge')
        || hasAnswerlatticePermission('canManageGovernance')
        || hasAnswerlatticePermission('canManageWidget')
        || hasAnswerlatticePermission('canManageSupport')
        || hasAnswerlatticePermission('canManageIntegrations')
        || hasAnswerlatticePermission('canExportData')
        || hasAnswerlatticePermission('canRebuildContext');
    }

    function hasAnswerlatticeReadinessPermission() {
      return hasAnswerlatticePermission('canViewReadiness')
        || hasAnswerlatticePermission('canManageKnowledge')
        || hasAnswerlatticePermission('canManageGovernance')
        || hasAnswerlatticePermission('canManageWidget')
        || hasAnswerlatticePermission('canManageIntegrations');
    }

    function hasAnswerlatticeKnowledgeControlPermission() {
      return hasAnswerlatticePermission('canManageKnowledge')
        || hasAnswerlatticePermission('canManageGovernance');
    }

    function hasAnswerlatticeSupportControlPermission() {
      return hasAnswerlatticePermission('canManageSupport')
        || hasAnswerlatticePermission('canManageWidget');
    }

    function isValidAnswerlatticeSupportBoardCard(data) {
      return data.keys().hasAll([
          'pId', 'tId', 'sId', 'title', 'description', 'status', 'priority',
          'sourceType', 'sourceId', 'notes', 'notesCount', 'statuses'
        ])
        && data.pId == 'AL'
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 140
        && data.description is string
        && data.description.size() <= 1200
        && [
          'new_signals', 'needs_triage', 'needs_answer', 'draft_ready',
          'approved_published', 'resolved'
        ].toSet().hasAny([data.status])
        && ['low', 'medium', 'high'].toSet().hasAny([data.priority])
        && [
          'manual', 'ticket', 'feedback', 'conversation', 'signal',
          'mutation_proposal', 'canonical_answer', 'release', 'surface'
        ].toSet().hasAny([data.sourceType])
        && data.notes is list
        && data.notes.size() <= 25
        && data.notesCount is int
        && data.notesCount == data.notes.size()
        && data.statuses is list
        && data.statuses.size() > 0
        && data.statuses.size() <= 50
        && (!data.keys().hasAny(['tags']) || (data.tags is list && data.tags.size() <= 8))
        && (!data.keys().hasAny(['relatedContextKeys']) || (data.relatedContextKeys is list && data.relatedContextKeys.size() <= 8));
    }

    function isValidAnswerlatticePendingMutationProposal(data) {
      return data.keys().hasAll([
          'pId', 'tId', 'sId', 'targetAnswerId', 'relatedEntityIds', 'mutationType',
          'signalSummary', 'suggestedChange', 'confidenceScore', 'status'
        ])
        && data.status == 'pending_review'
        && [
          'content_refinement',
          'scope_adjustment',
          'version_update',
          'new_answer_required'
        ].toSet().hasAny([data.mutationType])
        && data.targetAnswerId is string
        && data.targetAnswerId.size() <= 180
        && data.relatedEntityIds is list
        && data.relatedEntityIds.size() == 1
        && data.relatedEntityIds[0] is string
        && exists(/databases/$(database)/documents/answerlattice_entities/$(data.relatedEntityIds[0]))
        && get(/databases/$(database)/documents/answerlattice_entities/$(data.relatedEntityIds[0])).data.pId == 'AL'
        && string(get(/databases/$(database)/documents/answerlattice_entities/$(data.relatedEntityIds[0])).data.tId) == string(data.tId)
        && string(get(/databases/$(database)/documents/answerlattice_entities/$(data.relatedEntityIds[0])).data.sId) == string(data.sId)
        && data.signalSummary is map
        && data.suggestedChange is map
        && data.confidenceScore is number
        && data.confidenceScore >= 0
        && data.confidenceScore <= 1;
    }

    function isAnswerlatticeServerReservedAuditAction(data) {
      return !data.keys().hasAll(['action'])
        || !(data.action is string)
        || [
          'canonical_answer_created',
          'canonical_answer_updated',
          'canonical_answer_create_proposed',
          'canonical_answer_update_proposed',
          'draft_approved_as_canonical_answer',
          'drift_detected',
          'drift_cleared',
          'drift_manually_resolved',
          'entity_merged',
          'mutation_proposal_approved',
          'mutation_proposal_rejected',
          'mutation_proposal_marked_implemented',
          'answer_rollback_proposed'
        ].toSet().hasAny([data.action]);
    }

    function isAnswerlatticeSelfActor(data) {
      return data.keys().hasAll(['uId'])
        && (
          string(data.uId) == string(request.auth.uid)
          || string(data.uId) == string(request.auth.token.uId)
        );
    }

    function isAnswerlatticeSelfScopedCreate(data) {
      return isAuthenticated()
        && isAnswerlatticeTenantMember(data)
        && isAnswerlatticeSelfActor(data);
    }

    function isAnswerlatticeFeedbackSelfRead() {
      return isAuthenticated()
        && isAnswerlatticeTenantMember(resource.data)
        && isAnswerlatticeSelfActor(resource.data);
    }

    function isAnswerlatticeFeedbackSelfCreate() {
      return isAnswerlatticeSelfScopedCreate(request.resource.data);
    }

    function answerlatticeFeedbackDocumentKeys() {
      return [
        'type',
        'rating',
        'comment',
        'featureComment',
        'featureIssues',
        'featureRequest',
        'votedPopularRequests',
        'pId',
        'sourceContext',
        'traceId',
        'requestId',
        'sId',
        'tId',
        'role',
        'uId',
        'modifiedBy',
        'modifiedOn',
        'createdOn',
        'createdBy'
      ];
    }

    function isValidAnswerlatticeFeedbackText(value) {
      return value is string && value.size() > 0 && value.size() <= 1000;
    }

    function isValidAnswerlatticeFeedbackIdentifier(value) {
      return (value is string && value.size() > 0 && value.size() <= 180)
        || value is int;
    }

    function isValidAnswerlatticeFeedbackSourceContext(data) {
      return data.sourceContext == null
        || (
          data.sourceContext is map
          && data.sourceContext.keys().hasAll(['uId', 'name', 'email'])
          && data.sourceContext.keys().hasOnly(['uId', 'name', 'email', 'phone', 'pId', 'tId', 'sId'])
          && isValidAnswerlatticeFeedbackIdentifier(data.sourceContext.uId)
          && isValidAnswerlatticeFeedbackText(data.sourceContext.name)
          && isValidAnswerlatticeFeedbackText(data.sourceContext.email)
          && (!data.sourceContext.keys().hasAny(['phone']) || isValidAnswerlatticeFeedbackText(data.sourceContext.phone))
          && (
            !data.sourceContext.keys().hasAny(['pId'])
            || (
              data.sourceContext.pId is string
              && ['ML', 'AL', 'CC', 'MC', 'SD', 'SF', 'GR', 'KS'].toSet().hasAny([data.sourceContext.pId])
            )
          )
          && (!data.sourceContext.keys().hasAny(['tId']) || isValidAnswerlatticeFeedbackIdentifier(data.sourceContext.tId))
          && (!data.sourceContext.keys().hasAny(['sId']) || isValidAnswerlatticeFeedbackIdentifier(data.sourceContext.sId))
        );
    }

    function answerlatticeFeedbackFeatureIssueValues() {
      return [
        'Account access',
        'Billing and invoices',
        'Onboarding and setup',
        'Team roles and permissions',
        'Settings and configuration',
        'Integrations',
        'Data import or export',
        'Notifications and email',
        'Reports and analytics',
        'Performance or reliability'
      ];
    }

    function answerlatticeFeedbackPopularRequestValues() {
      return [
        'Clearer setup guides',
        'More integration options',
        'Better billing controls',
        'Easier data export and reports',
        'Faster issue status updates'
      ];
    }

    function isValidAnswerlatticeFeedbackVote(vote) {
      return vote is map
        && vote.keys().hasAll(['feature', 'interested'])
        && vote.keys().hasOnly(['feature', 'interested'])
        && vote.feature is string
        && answerlatticeFeedbackPopularRequestValues().toSet().hasAny([vote.feature])
        && vote.interested is bool;
    }

    function hasUniqueAnswerlatticeFeedbackVotes(votes) {
      return (votes.size() < 2 || votes[0].feature != votes[1].feature)
        && (votes.size() < 3 || (votes[0].feature != votes[2].feature && votes[1].feature != votes[2].feature))
        && (votes.size() < 4 || (votes[0].feature != votes[3].feature && votes[1].feature != votes[3].feature && votes[2].feature != votes[3].feature))
        && (votes.size() < 5 || (votes[0].feature != votes[4].feature && votes[1].feature != votes[4].feature && votes[2].feature != votes[4].feature && votes[3].feature != votes[4].feature));
    }

    function isValidAnswerlatticeFeedbackVotes(data) {
      return !data.keys().hasAny(['votedPopularRequests'])
        || (
          data.votedPopularRequests is list
          && data.votedPopularRequests.size() > 0
          && data.votedPopularRequests.size() <= 5
          && isValidAnswerlatticeFeedbackVote(data.votedPopularRequests[0])
          && (data.votedPopularRequests.size() < 2 || isValidAnswerlatticeFeedbackVote(data.votedPopularRequests[1]))
          && (data.votedPopularRequests.size() < 3 || isValidAnswerlatticeFeedbackVote(data.votedPopularRequests[2]))
          && (data.votedPopularRequests.size() < 4 || isValidAnswerlatticeFeedbackVote(data.votedPopularRequests[3]))
          && (data.votedPopularRequests.size() < 5 || isValidAnswerlatticeFeedbackVote(data.votedPopularRequests[4]))
          && hasUniqueAnswerlatticeFeedbackVotes(data.votedPopularRequests)
        );
    }

    function isValidAnswerlatticeFeedbackPayload(data) {
      return data.keys().hasAll([
          'type', 'pId', 'sourceContext', 'traceId', 'requestId', 'sId', 'tId', 'role',
          'uId', 'modifiedBy', 'modifiedOn', 'createdOn', 'createdBy'
        ])
        && data.keys().hasOnly(answerlatticeFeedbackDocumentKeys())
        && data.pId == 'AL'
        && isValidAnswerlatticeFeedbackIdentifier(data.tId)
        && isValidAnswerlatticeFeedbackIdentifier(data.sId)
        && isValidAnswerlatticeFeedbackIdentifier(data.uId)
        && isValidAnswerlatticeFeedbackText(data.traceId)
        && data.traceId.size() <= 180
        && isValidAnswerlatticeFeedbackText(data.requestId)
        && data.requestId.size() <= 180
        && data.role is string
        && data.role.size() <= 80
        && data.modifiedBy is string
        && data.modifiedBy.size() <= 200
        && data.createdBy is string
        && data.createdBy.size() <= 200
        && data.modifiedOn is timestamp
        && data.createdOn is timestamp
        && isValidAnswerlatticeFeedbackSourceContext(data)
        && (
          (
            data.type == 'general'
            && data.keys().hasAll(['rating', 'comment'])
            && !data.keys().hasAny(['featureComment', 'featureIssues', 'featureRequest', 'votedPopularRequests'])
            && data.rating is int
            && data.rating >= 1
            && data.rating <= 5
            && isValidAnswerlatticeFeedbackText(data.comment)
          )
          || (
            data.type == 'feature_usage'
            && !data.keys().hasAny(['rating', 'comment', 'featureRequest', 'votedPopularRequests'])
            && (data.keys().hasAny(['featureComment']) || data.keys().hasAny(['featureIssues']))
            && (!data.keys().hasAny(['featureComment']) || isValidAnswerlatticeFeedbackText(data.featureComment))
            && (
              !data.keys().hasAny(['featureIssues'])
              || (
                data.featureIssues is list
                && data.featureIssues.size() > 0
                && data.featureIssues.size() <= 10
                && data.featureIssues.toSet().size() == data.featureIssues.size()
                && data.featureIssues.toSet().difference(answerlatticeFeedbackFeatureIssueValues().toSet()).size() == 0
              )
            )
          )
          || (
            data.type == 'feature_requests'
            && !data.keys().hasAny(['rating', 'comment', 'featureComment', 'featureIssues'])
            && (data.keys().hasAny(['featureRequest']) || data.keys().hasAny(['votedPopularRequests']))
            && (!data.keys().hasAny(['featureRequest']) || isValidAnswerlatticeFeedbackText(data.featureRequest))
            && isValidAnswerlatticeFeedbackVotes(data)
          )
        );
    }

    function isValidAnswerlatticeFeedbackSurfaceValue(data, field) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || (data[field] is string && data[field].size() > 0 && data[field].size() <= 180);
    }

    function isValidAnswerlatticeFeedbackSurfaceUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contextKey', 'surfaceId', 'surfaceLabel', 'surfaceAssignedBy', 'surfaceAssignedAt', 'modifiedBy', 'modifiedOn'
        ])
        && isValidAnswerlatticeFeedbackSurfaceValue(request.resource.data, 'contextKey')
        && isValidAnswerlatticeFeedbackSurfaceValue(request.resource.data, 'surfaceId')
        && isValidAnswerlatticeFeedbackSurfaceValue(request.resource.data, 'surfaceLabel')
        && isValidAnswerlatticeFeedbackSurfaceValue(request.resource.data, 'surfaceAssignedBy')
        && request.resource.data.keys().hasAll(['surfaceAssignedAt', 'modifiedBy', 'modifiedOn'])
        && (request.resource.data.surfaceAssignedAt == null || request.resource.data.surfaceAssignedAt is timestamp)
        && request.resource.data.modifiedBy is string
        && request.resource.data.modifiedBy.size() > 0
        && request.resource.data.modifiedBy.size() <= 200
        && request.resource.data.modifiedOn is timestamp
        && (
          (
            request.resource.data.contextKey == null
            && request.resource.data.surfaceId == null
            && request.resource.data.surfaceLabel == null
            && request.resource.data.surfaceAssignedBy == null
            && request.resource.data.surfaceAssignedAt == null
          )
          || (
            request.resource.data.surfaceAssignedBy is string
            && request.resource.data.surfaceAssignedBy.size() > 0
            && request.resource.data.surfaceAssignedAt is timestamp
          )
        );
    }

    function isAnswerlatticeFeedbackSignalCreate() {
      return isAnswerlatticeSelfScopedCreate(request.resource.data)
        && request.resource.data.type == 'feedback'
        && request.resource.data.entityId == 'unresolved'
        && request.resource.data.keys().hasAll(['metadata'])
        && request.resource.data.metadata is map
        && request.resource.data.metadata.keys().hasAll(['source'])
        && request.resource.data.metadata.source == 'help_center_feedback';
    }

    function isValidAnswerlatticeSignalCreate(data) {
      return data.keys().hasAll(['pId', 'tId', 'sId', 'entityId', 'type', 'timestamp', 'expiresAt'])
        && data.keys().hasOnly([
          'pId', 'tId', 'sId', 'entityId', 'type', 'timestamp', 'metadata', 'dedupKey',
          'sourceContext', 'traceId', 'requestId', 'role', 'uId', 'createdOn', 'modifiedOn',
          'createdBy', 'modifiedBy', 'expiresAt'
        ])
        && data.pId == 'AL'
        && data.entityId is string
        && data.entityId.size() > 0
        && data.entityId.size() <= 180
        && data.type in [
          'ticket', 'chat_negative', 'escalation', 'feedback',
          'suggestion_shown', 'suggestion_clicked', 'suggestion_dismissed'
        ]
        && data.timestamp is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt > data.timestamp
        && data.expiresAt <= data.timestamp + duration.value(366, 'd')
        && (!data.keys().hasAny(['metadata']) || (data.metadata is map && data.metadata.size() <= 30))
        && (!data.keys().hasAny(['dedupKey']) || (data.dedupKey is string && data.dedupKey.size() <= 260))
        && (!data.keys().hasAny(['requestId']) || (data.requestId is string && data.requestId.size() <= 260));
    }

    function answerlatticeContentFeedbackKeys() {
      return [
        'list',
        'pId',
        'sourceContext',
        'traceId',
        'requestId',
        'sId',
        'tId',
        'role',
        'uId',
        'modifiedBy',
        'modifiedOn',
        'createdOn',
        'createdBy'
      ];
    }

    function isAnswerlatticeContentFeedbackDoc(data) {
      return data.keys().hasAll(['list', 'pId', 'tId', 'sId'])
        && data.keys().hasOnly(answerlatticeContentFeedbackKeys())
        && data.pId == 'AL'
        && data.list is list
        && data.list.size() <= 200;
    }

    function isValidAnswerlatticeContentFeedbackSourceContext(sourceContext) {
      return sourceContext is map
        && sourceContext.keys().hasAll(['uId', 'name', 'email'])
        && sourceContext.keys().hasOnly(['uId', 'name', 'email', 'phone', 'pId', 'tId', 'sId'])
        && isValidAnswerlatticeFeedbackIdentifier(sourceContext.uId)
        && sourceContext.name is string
        && sourceContext.name.size() > 0
        && sourceContext.name.size() <= 160
        && sourceContext.email is string
        && sourceContext.email.size() <= 180
        && (!sourceContext.keys().hasAny(['phone']) || (sourceContext.phone is string && sourceContext.phone.size() > 0 && sourceContext.phone.size() <= 80))
        && (
          !sourceContext.keys().hasAny(['pId'])
          || (
            sourceContext.pId is string
            && ['ML', 'AL', 'CC', 'MC', 'SD', 'SF', 'GR', 'KS'].toSet().hasAny([sourceContext.pId])
          )
        )
        && (!sourceContext.keys().hasAny(['tId']) || (sourceContext.tId is int && sourceContext.tId > 0))
        && (!sourceContext.keys().hasAny(['sId']) || (sourceContext.sId is int && sourceContext.sId > 0));
    }

    function isAnswerlatticeContentFeedbackActor(item) {
      return isPlatformAdmin()
        || item.uId == request.auth.uid
        || item.uId == request.auth.token.get('uId', '');
    }

    function isValidAnswerlatticeContentFeedbackItem(item) {
      return item is map
        && item.keys().hasAll(['comment', 'sentiment', 'action', 'createdOn', 'uId', 'userName', 'sourceContext'])
        && item.keys().hasOnly(['comment', 'sentiment', 'action', 'createdOn', 'uId', 'userName', 'userEmail', 'userPhone', 'sourceContext'])
        && item.comment is string
        && item.comment.size() <= 500
        && (item.sentiment == 'like' || item.sentiment == 'dislike')
        && (item.action == 'added' || item.action == 'removed')
        && item.createdOn is timestamp
        && item.uId is string
        && item.uId.size() > 0
        && item.uId.size() <= 180
        && item.userName is string
        && item.userName.size() > 0
        && item.userName.size() <= 160
        && (!item.keys().hasAny(['userEmail']) || (item.userEmail is string && item.userEmail.size() > 0 && item.userEmail.size() <= 180))
        && (!item.keys().hasAny(['userPhone']) || (item.userPhone is string && item.userPhone.size() > 0 && item.userPhone.size() <= 80))
        && isValidAnswerlatticeContentFeedbackSourceContext(item.sourceContext)
        && isAnswerlatticeContentFeedbackActor(item);
    }

    function isAnswerlatticeContentFeedbackRead(tId, sId) {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            isAnswerlatticeTenantPath(tId, sId)
            && hasAnyAnswerlatticePermission()
          )
        );
    }

    function isAnswerlatticeContentFeedbackCreate(tId, sId) {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            isAnswerlatticeTenantPath(tId, sId)
            && isAnswerlatticeTenantMember(request.resource.data)
            && hasAnyAnswerlatticePermission()
          )
        )
        && isAnswerlatticeContentFeedbackDoc(request.resource.data)
        && request.resource.data.list.size() == 1
        && isValidAnswerlatticeContentFeedbackItem(request.resource.data.list[0]);
    }

    function isAnswerlatticeContentFeedbackUpdate(tId, sId) {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || (
            isAnswerlatticeTenantPath(tId, sId)
            && isAnswerlatticeTenantMember(resource.data)
            && isAnswerlatticeTenantMember(request.resource.data)
            && request.resource.data.tId == resource.data.tId
            && request.resource.data.sId == resource.data.sId
            && hasAnyAnswerlatticePermission()
          )
        )
        && isAnswerlatticeContentFeedbackDoc(resource.data)
        && isAnswerlatticeContentFeedbackDoc(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['list', 'modifiedOn', 'modifiedBy'])
        && resource.data.list.size() < 200
        && request.resource.data.list.size() == resource.data.list.size() + 1
        && isValidAnswerlatticeContentFeedbackItem(request.resource.data.list[request.resource.data.list.size() - 1])
        && request.resource.data.list == resource.data.list.concat([request.resource.data.list[request.resource.data.list.size() - 1]]);
    }

    function kbCategoriesDocMatchesCurrentStore(docId) {
      return request.auth != null
        && request.auth.token.tenantId != null
        && request.auth.token.storeId != null
        && docId == 'categories_' + string(request.auth.token.tenantId) + '_' + string(request.auth.token.storeId);
    }

    function isAnswerlatticePlatformSummaryDoc(document) {
      return document.matches('^(branding|coverage|friction|frictionSnapshot|trustMetrics|supportBoardSummary|knowledgeIntakeSummary|entityGraph|entityGraphIndex|interactionRules|predictiveTriggers|contextContent|sourceVersions|bundleManifest|integrationConfig|integrationHealth)_.*$');
    }

    function isAnswerlatticePlatformSummaryClientReadableDoc(document) {
      return isAnswerlatticePlatformSummaryDoc(document)
        && !document.matches('^(sourceVersions|bundleManifest|integrationConfig)_.*$');
    }

    function isAnswerlatticeSourceVersionsDoc(document) {
      return document.matches('^sourceVersions_.*$');
    }

    function isAnswerlatticeBundleManifestDoc(document) {
      return document.matches('^bundleManifest_.*$');
    }

    function isAnswerlatticePlatformSummaryDocumentScopeValid(document, data) {
      return data.keys().hasAll(['tId', 'sId'])
        && (
          document == 'branding_' + string(data.tId) + '_' + string(data.sId)
          || document == 'coverage_' + string(data.tId) + '_' + string(data.sId)
          || document == 'friction_' + string(data.tId) + '_' + string(data.sId)
          || document == 'frictionSnapshot_' + string(data.tId) + '_' + string(data.sId)
          || document == 'trustMetrics_' + string(data.tId) + '_' + string(data.sId)
          || document == 'supportBoardSummary_' + string(data.tId) + '_' + string(data.sId)
          || document == 'knowledgeIntakeSummary_' + string(data.tId) + '_' + string(data.sId)
          || document == 'entityGraph_' + string(data.tId) + '_' + string(data.sId)
          || document == 'entityGraphIndex_' + string(data.tId) + '_' + string(data.sId)
          || document == 'interactionRules_' + string(data.tId) + '_' + string(data.sId)
          || document == 'predictiveTriggers_' + string(data.tId) + '_' + string(data.sId)
          || document == 'contextContent_' + string(data.tId) + '_' + string(data.sId)
          || document == 'sourceVersions_' + string(data.tId) + '_' + string(data.sId)
          || document == 'bundleManifest_' + string(data.tId) + '_' + string(data.sId)
          || document == 'integrationConfig_' + string(data.tId) + '_' + string(data.sId)
          || document == 'integrationHealth_' + string(data.tId) + '_' + string(data.sId)
        );
    }

    function hasAnswerlatticePlatformSummaryReadPermission(document) {
      return (
          document.matches('^(coverage|friction|frictionSnapshot|trustMetrics)_.*$')
          && hasAnswerlatticeReadinessPermission()
        )
        || (
          document.matches('^supportBoardSummary_.*$')
          && hasAnswerlatticeSupportControlPermission()
        )
        || (
          document.matches('^knowledgeIntakeSummary_.*$')
          && hasAnswerlatticeKnowledgeControlPermission()
        )
        || (
          document.matches('^(entityGraph|entityGraphIndex|interactionRules|predictiveTriggers|contextContent)_.*$')
          && hasAnswerlatticeKnowledgeControlPermission()
        )
        || (
          document.matches('^branding_.*$')
          && (
            hasAnswerlatticePermission('canManageWidget')
            || hasAnswerlatticePermission('canManageWorkspace')
            || hasAnswerlatticeKnowledgeControlPermission()
          )
        )
        || (
          document.matches('^integrationHealth_.*$')
          && hasAnswerlatticePermission('canManageIntegrations')
        );
    }

    function hasAnswerlatticePlatformSummaryWritePermission(document) {
      return (
          document.matches('^(predictiveTriggers|sourceVersions|bundleManifest)_.*$')
          && (
            hasAnswerlatticeKnowledgeControlPermission()
            || hasAnswerlatticePermission('canRebuildContext')
          )
        )
        || (
          document.matches('^branding_.*$')
          && (
            hasAnswerlatticePermission('canManageWidget')
            || hasAnswerlatticePermission('canManageWorkspace')
            || hasAnswerlatticeKnowledgeControlPermission()
          )
        )
        ;
    }

    function answerlatticeSourceVersionClientKeys() {
      return [
        'schemaVersion',
        'pId',
        'tId',
        'sId',
        'workspaceProfile',
        'widgetConfig',
        'kb',
        'docsNav',
        'entities',
        'entityRelations',
