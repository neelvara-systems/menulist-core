{
  "name": "ecomsai-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "kill -9 $(lsof -t -i:3000) 2>/dev/null; kill -9 $(lsof -t -i:3001) 2>/dev/null; next dev",
    "dev:emulators": "next lint && next dev && npm run firebase:emulators",
    "devhttps": "next dev --experimental-https",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' next build",
    "build:prod": "NODE_OPTIONS='--max-old-space-size=8192' NODE_ENV=production next build",
    "build:analyze": "ANALYZE=true NODE_OPTIONS='--max-old-space-size=8192' npm run build",
    "start": "next start",
    "lint": "next lint",
    "devstart": "npm run dev",
    "firebase:emulators": "firebase emulators:start --project ecomsai",
    "docs:generate": "node scripts/generate-docs-index.js",
    "verify:recycle-bin": "node scripts/verification/verify-recycle-bin.js"
  },
